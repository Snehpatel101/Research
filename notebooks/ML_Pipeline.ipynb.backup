    "#@title 4.4 Model Explainability (SHAP + Feature Importance) { display-mode: \"form\" }",
    "",
    "print(\"=\" * 70)",
    "print(\" 4.4 MODEL EXPLAINABILITY ANALYSIS\")",
    "print(\"=\" * 70)",
    "",
    "if not config.training_results:",
    "    print(\"[WARNING] No trained models found. Run 4.1 Train Models first.\")",
    "else:",
    "    # Check if SHAP is installed",
    "    try:",
    "        import shap",
    "        shap_available = True",
    "        print(\"\u2713 SHAP library available\")",
    "    except ImportError:",
    "        shap_available = False",
    "        print(\"[WARNING] SHAP not installed. Run: pip install shap\")",
    "        print(\"         Feature importance will still be displayed for tree models.\")",
    "",
    "    print()",
    "",
    "    # Process each trained model",
    "    for model_name, result in config.training_results.items():",
    "        if 'error' in result or 'model' not in result:",
    "            continue",
    "",
    "        print(f\"\\n{'='*70}\")",
    "        print(f\" Model: {model_name.upper()}\")",
    "        print('='*70)",
    "",
    "        model = result['model']",
    "",
    "        # Determine model family",
    "        is_tree_model = model_name in ['xgboost', 'lightgbm', 'catboost', 'random_forest']",
    "        is_neural_model = model_name in ['lstm', 'gru', 'tcn', 'transformer', 'patchtst', 'itransformer']",
    "",
    "        # ============================================================",
    "        # FEATURE IMPORTANCE (Tree Models)",
    "        # ============================================================",
    "",
    "        if SHOW_FEATURE_IMPORTANCE and is_tree_model:",
    "            print(f\"\\n--- Feature Importance ({model_name}) ---\")",
    "            try:",
    "                # Extract feature importance",
    "                if hasattr(model, 'feature_importances_'):",
    "                    importance = model.feature_importances_",
    "                elif hasattr(model, 'get_feature_importance'):  # CatBoost",
    "                    importance = model.get_feature_importance()",
    "                else:",
    "                    print(\"[WARNING] Model does not support feature importance\")",
    "                    importance = None",
    "",
    "                if importance is not None:",
    "                    feature_names = config.container.feature_columns",
    "",
    "                    # Store in config",
    "                    config.feature_importance[model_name] = {",
    "                        'importance': importance.tolist(),",
    "                        'features': feature_names,",
    "                        'top_10': sorted(",
    "                            zip(feature_names, importance),",
    "                            key=lambda x: x[1],",
    "                            reverse=True",
    "                        )[:10]",
    "                    }",
    "",
    "                    # Display top N features",
    "                    print(f\"\\nTop {TOP_N_FEATURES} Features:\")",
    "                    sorted_features = sorted(",
    "                        zip(feature_names, importance),",
    "                        key=lambda x: x[1],",
    "                        reverse=True",
    "                    )[:TOP_N_FEATURES]",
    "",
    "                    for i, (feat, imp) in enumerate(sorted_features, 1):",
    "                        print(f\"  {i:2d}. {feat:40s} {imp:.6f}\")",
    "",
    "                    # Categorize features",
    "                    categories = categorize_features(feature_names)",
    "                    print(f\"\\nFeature Categories:\")",
    "                    for cat, feats in categories.items():",
    "                        if feats:",
    "                            cat_importance = sum(importance[feature_names.index(f)] for f in feats if f in feature_names)",
    "                            print(f\"  {cat:15s}: {len(feats):3d} features, total importance: {cat_importance:.4f}\")",
    "",
    "                    # Plot",
    "                    plot_top_features(",
    "                        config.feature_importance[model_name],",
    "                        top_n=TOP_N_FEATURES,",
    "                        title=f\"Top {TOP_N_FEATURES} Features - {model_name.upper()}\"",
    "                    )",
    "",
    "                    # Export if requested",
    "                    if EXPORT_FEATURE_IMPORTANCE:",
    "                        import json",
    "                        export_path = config.run_dir / f\"feature_importance_{model_name}.json\"",
    "                        with open(export_path, 'w') as f:",
    "                            json.dump(config.feature_importance[model_name], f, indent=2)",
    "                        print(f\"\\n\u2713 Feature importance exported to: {export_path}\")",
    "",
    "            except Exception as e:",
    "                print(f\"[ERROR] Feature importance extraction failed: {e}\")",
    "",
    "        # ============================================================",
    "        # SHAP ANALYSIS",
    "        # ============================================================",
    "",
    "        if RUN_SHAP_ANALYSIS and shap_available:",
    "            print(f\"\\n--- SHAP Analysis ({model_name}) ---\")",
    "",
    "            try:",
    "                # Get test data",
    "                X_test = config.container.X_test",
    "                y_test = config.container.y_test",
    "",
    "                # Subsample for speed",
    "                n_test = min(SHAP_TEST_SAMPLES, len(X_test))",
    "                test_indices = np.random.choice(len(X_test), n_test, replace=False)",
    "                X_test_sample = X_test[test_indices]",
    "                y_test_sample = y_test[test_indices]",
    "",
    "                if is_tree_model:",
    "                    print(f\"Computing SHAP values (TreeExplainer, {n_test} samples)...\")",
    "                    shap_values = compute_shap_values_safe(",
    "                        model, X_test_sample, None, model_type='tree'",
    "                    )",
    "",
    "                    if shap_values is not None:",
    "                        feature_names = config.container.feature_columns",
    "",
    "                        # Store in config",
    "                        config.shap_results[model_name] = {",
    "                            'shap_values': shap_values,",
    "                            'test_indices': test_indices,",
    "                            'feature_names': feature_names",
    "                        }",
    "",
    "                        # Summary plot (beeswarm)",
    "                        print(\"\\nGenerating SHAP summary plot...\")",
    "                        shap.summary_plot(shap_values, X_test_sample, feature_names=feature_names, show=False)",
    "                        plt.title(f\"SHAP Summary - {model_name.upper()}\")",
    "                        plt.tight_layout()",
    "                        plt.show()",
    "",
    "                        # Bar plot (mean absolute SHAP)",
    "                        print(\"\\nGenerating SHAP bar plot...\")",
    "                        shap.summary_plot(shap_values, X_test_sample, feature_names=feature_names, plot_type='bar', show=False)",
    "                        plt.title(f\"SHAP Feature Importance - {model_name.upper()}\")",
    "                        plt.tight_layout()",
    "                        plt.show()",
    "",
    "                        # Top-10 SHAP contributors for first 5 predictions",
    "                        print(f\"\\nTop-10 SHAP Contributors (First 5 predictions):\")",
    "                        predictions = model.predict_proba(X_test_sample)",
    "",
    "                        for i in range(min(5, len(X_test_sample))):",
    "                            pred_class = np.argmax(predictions[i])",
    "                            pred_label = ['Short', 'Hold', 'Long'][pred_class]",
    "                            actual_label = ['Short', 'Hold', 'Long'][y_test_sample[i]]",
    "",
    "                            print(f\"\\n--- Prediction {i+1} (Actual: {actual_label}, Predicted: {pred_label}) ---\")",
    "",
    "                            feature_contributions = sorted(",
    "                                zip(feature_names, shap_values[i]),",
    "                                key=lambda x: abs(x[1]),",
    "                                reverse=True",
    "                            )[:10]",
    "",
    "                            for feat, contrib in feature_contributions:",
    "                                print(f\"  {feat:40s}: {contrib:+.6f}\")",
    "",
    "                        # Waterfall plot for first prediction",
    "                        print(\"\\nGenerating waterfall plot for first prediction...\")",
    "                        shap.plots.waterfall(",
    "                            shap.Explanation(",
    "                                values=shap_values[0],",
    "                                base_values=np.mean(shap_values),",
    "                                data=X_test_sample[0],",
    "                                feature_names=feature_names",
    "                            ),",
    "                            show=False",
    "                        )",
    "                        plt.title(f\"SHAP Waterfall - {model_name.upper()} (Prediction 1)\")",
    "                        plt.tight_layout()",
    "                        plt.show()",
    "",
    "                        # Dependence plots for top 3 features",
    "                        print(\"\\nGenerating dependence plots for top 3 features...\")",
    "                        mean_abs_shap = np.abs(shap_values).mean(axis=0)",
    "                        top_3_indices = np.argsort(mean_abs_shap)[-3:][::-1]",
    "",
    "                        for idx in top_3_indices:",
    "                            feat_name = feature_names[idx]",
    "                            shap.dependence_plot(",
    "                                idx, shap_values, X_test_sample,",
    "                                feature_names=feature_names,",
    "                                show=False",
    "                            )",
    "                            plt.title(f\"SHAP Dependence - {feat_name} ({model_name.upper()})\")",
    "                            plt.tight_layout()",
    "                            plt.show()",
    "",
    "                        # Export if requested",
    "                        if EXPORT_SHAP_VALUES:",
    "                            import pandas as pd",
    "                            shap_df = pd.DataFrame(",
    "                                shap_values,",
    "                                columns=feature_names",
    "                            )",
    "                            export_path = config.run_dir / f\"shap_values_{model_name}.csv\"",
    "                            shap_df.to_csv(export_path, index=False)",
    "                            print(f\"\\n\u2713 SHAP values exported to: {export_path}\")",
    "",
    "                elif is_neural_model and RUN_SHAP_ANALYSIS:",
    "                    print(f\"[INFO] SHAP for neural models requires background dataset and is slower.\")",
    "                    print(f\"      Skipping for now. Consider using GradientExplainer for neural models.\")",
    "",
    "            except Exception as e:",
    "                print(f\"[ERROR] SHAP analysis failed: {e}\")",
    "                import traceback",
    "                traceback.print_exc()",
    "",
    "print(\"\\n\" + \"=\" * 70)",
    "print(\" Explainability analysis complete\")",
    "print(\"=\" * 70)",
    ""
   ]
