   "source": [
    "#@title 2.3 Checkpoint Utilities { display-mode: \"form\" }\n",
    "\n",
    "import joblib\n",
    "from pathlib import Path\n",
    "from datetime import datetime\n",
    "\n",
    "config = require_config()\n",
    "\n",
    "def save_checkpoint(data: Any, name: str, to_drive: bool = True) -> Optional[Path]:\n",
    "    \"\"\"Save checkpoint to local and optionally to Drive.\n",
    "    \n",
    "    Args:\n",
    "        data: Any picklable object\n",
    "        name: Checkpoint name (without extension)\n",
    "        to_drive: If True and in Colab with Drive mounted, also save to Drive\n",
    "    \n",
    "    Returns:\n",
    "        Path to saved checkpoint\n",
    "    \"\"\"\n",
    "    config.checkpoint_dir.mkdir(parents=True, exist_ok=True)\n",
    "    \n",
    "    timestamp = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n",
    "    filename = f\"{name}_{timestamp}.pkl\"\n",
    "    \n",
    "    # Save locally\n",
    "    local_path = config.checkpoint_dir / filename\n",
    "    joblib.dump(data, local_path)\n",
    "    print(f\"[Checkpoint] Saved: {local_path}\")\n",
    "    \n",
    "    # Save to Drive if in Colab\n",
    "    if to_drive and config.is_colab and config.drive_mounted:\n",
    "        drive_checkpoint_dir = Path('/content/drive/MyDrive/ml_checkpoints')\n",
    "        drive_checkpoint_dir.mkdir(parents=True, exist_ok=True)\n",
    "        drive_path = drive_checkpoint_dir / filename\n",
    "        joblib.dump(data, drive_path)\n",
    "        print(f\"[Checkpoint] Drive backup: {drive_path}\")\n",
    "    \n",
    "    return local_path\n",
    "\n",
    "def load_checkpoint(name: str, from_drive: bool = True) -> Optional[Any]:\n",
    "    \"\"\"Load checkpoint from local or Drive.\n",
    "    \n",
    "    Args:\n",
    "        name: Checkpoint name pattern (will load latest matching)\n",
    "        from_drive: If True and in Colab, prefer Drive checkpoints\n",
    "    \n",
    "    Returns:\n",
    "        Loaded checkpoint data or None if not found\n",
    "    \"\"\"\n",
    "    search_dirs = [config.checkpoint_dir]\n",
    "    \n",
    "    if from_drive and config.is_colab and config.drive_mounted:\n",
    "        drive_dir = Path('/content/drive/MyDrive/ml_checkpoints')\n",
    "        if drive_dir.exists():\n",
    "            search_dirs.insert(0, drive_dir)  # Prefer Drive\n",
    "    \n",
    "    for search_dir in search_dirs:\n",
    "        if not search_dir.exists():\n",
    "            continue\n",
    "        \n",
    "        # Find matching checkpoints\n",
    "        matches = sorted(\n",
    "            search_dir.glob(f\"{name}_*.pkl\"),\n",
    "            key=lambda p: p.stat().st_mtime,\n",
    "            reverse=True\n",
    "        )\n",
    "        \n",
    "        if matches:\n",
    "            checkpoint_path = matches[0]\n",
    "            print(f\"[Checkpoint] Loading: {checkpoint_path}\")\n",
    "            return joblib.load(checkpoint_path)\n",
    "    \n",
    "    print(f\"[Checkpoint] No checkpoint found for: {name}\")\n",
    "    return None\n",
    "\n",
    "def list_checkpoints() -> List[Path]:\n",
    "    \"\"\"List all available checkpoints.\"\"\"\n",
    "    checkpoints = []\n",
    "    \n",
    "    if config.checkpoint_dir.exists():\n",
    "        checkpoints.extend(config.checkpoint_dir.glob(\"*.pkl\"))\n",
    "    \n",
    "    if config.is_colab and config.drive_mounted:\n",
    "        drive_dir = Path('/content/drive/MyDrive/ml_checkpoints')\n",
    "        if drive_dir.exists():\n",
    "            checkpoints.extend(drive_dir.glob(\"*.pkl\"))\n",
    "    \n",
    "    return sorted(checkpoints, key=lambda p: p.stat().st_mtime, reverse=True)\n",
    "\n",
    "print(\"Checkpoint utilities loaded.\")\n",
    "print(f\"Checkpoint directory: {config.checkpoint_dir}\")",
    "\n",
    "# ============================================================\n",
    "# KELLY CRITERION CALCULATOR\n",
    "# ============================================================\n",
    "\n",
    "def calculate_kelly_fraction(predictions, actuals, prices, max_position_pct=0.25):\n",
    "    \"\"\"Calculate Kelly criterion position sizing based on historical performance.\n",
    "    \n",
    "    Args:\n",
    "        predictions: Model predictions (0=Short, 1=Hold, 2=Long)\n",
    "        actuals: Actual outcomes\n",
    "        prices: Asset prices\n",
    "        max_position_pct: Maximum position size as fraction of capital\n",
    "    \n",
    "    Returns:\n",
    "        kelly_fractions: Array of position sizes for each trade\n",
    "    \"\"\"\n",
    "    import numpy as np\n",
    "    \n",
    "    # Filter to actual trades (exclude Hold)\n",
    "    trades = predictions != 1\n",
    "    trade_preds = predictions[trades]\n",
    "    trade_actuals = actuals[trades]\n",
    "    trade_prices = prices[trades]\n",
    "    \n",
    "    if len(trade_preds) < 2:\n",
    "        return np.full(len(predictions), 0.01)  # Minimal position\n",
    "    \n",
    "    # Calculate wins/losses\n",
    "    correct = (trade_preds == trade_actuals)\n",
    "    \n",
    "    if len(correct) < 2:\n",
    "        return np.full(len(predictions), 0.01)\n",
    "    \n",
    "    # Calculate returns for wins and losses\n",
    "    returns = np.diff(trade_prices) / trade_prices[:-1]\n",
    "    win_returns = returns[correct[:-1]]\n",
    "    loss_returns = returns[~correct[:-1]]\n",
    "    \n",
    "    if len(win_returns) == 0 or len(loss_returns) == 0:\n",
    "        return np.full(len(predictions), 0.01)  # Minimal position\n",
    "    \n",
    "    win_rate = len(win_returns) / len(returns)\n",
    "    avg_win = np.abs(np.mean(win_returns))\n",
    "    avg_loss = np.abs(np.mean(loss_returns))\n",
    "    \n",
    "    # Kelly formula: f = (p*b - q) / b\n",
    "    # where p = win_rate, q = 1-p, b = avg_win/avg_loss\n",
    "    b = avg_win / avg_loss if avg_loss > 0 else 1.0\n",
    "    kelly = (win_rate * b - (1 - win_rate)) / b\n",
    "    kelly = np.clip(kelly, 0, max_position_pct)\n",
    "    \n",
    "    # Expanding window: recalculate Kelly as more data arrives\n",
    "    kelly_fractions = np.zeros(len(predictions))\n",
    "    for i in range(len(predictions)):\n",
    "        if i < 30:  # Minimum warmup period\n",
    "            kelly_fractions[i] = 0.01\n",
    "        else:\n",
    "            # Recalculate based on last 100 trades\n",
    "            lookback = min(i, 100)\n",
    "            recent_preds = predictions[max(0, i-lookback):i]\n",
    "            recent_actuals = actuals[max(0, i-lookback):i]\n",
    "            recent_trades = recent_preds != 1\n",
    "            \n",
    "            if np.sum(recent_trades) > 10:  # Need at least 10 trades\n",
    "                recent_correct = (recent_preds[recent_trades] == recent_actuals[recent_trades])\n",
    "                recent_win_rate = np.mean(recent_correct)\n",
    "                recent_kelly = (recent_win_rate * b - (1 - recent_win_rate)) / b\n",
    "                kelly_fractions[i] = np.clip(recent_kelly, 0, max_position_pct)\n",
    "            else:\n",
    "                kelly_fractions[i] = 0.01\n",
    "    \n",
    "    return kelly_fractions\n",
    "\n",
    "print(\"Kelly criterion calculator loaded.\")\n",
    "\n",
    "\n\n# ============================================================\n# SHAP & Feature Importance Utilities\n# ============================================================\n\ndef compute_shap_values_safe(model, X_test, X_background, model_type='tree'):\n    \"\"\"Safely compute SHAP values with error handling.\n\n    Args:\n        model: Trained model\n        X_test: Test data to explain\n        X_background: Background data for SHAP\n        model_type: 'tree', 'deep', or 'linear'\n\n    Returns:\n        shap_values: SHAP values array or None if failed\n    \"\"\"\n    try:\n        import shap\n\n        if model_type == 'tree':\n            explainer = shap.TreeExplainer(model)\n        elif model_type == 'deep':\n            explainer = shap.DeepExplainer(model, X_background)\n        else:\n            explainer = shap.LinearExplainer(model, X_background)\n\n        shap_values = explainer.shap_values(X_test)\n\n        # For multi-class, take values for class 2 (Long)\n        if isinstance(shap_values, list) and len(shap_values) > 2:\n            shap_values = shap_values[2]\n\n        return shap_values\n\n    except Exception as e:\n        print(f\"[ERROR] SHAP computation failed: {e}\")\n        return None\n\n\ndef plot_top_features(feature_importance_dict, top_n=20, title=\"Top Features\"):\n    \"\"\"Plot top N features by importance.\"\"\"\n    import matplotlib.pyplot as plt\n\n    sorted_features = sorted(\n        zip(feature_importance_dict['features'], feature_importance_dict['importance']),\n        key=lambda x: x[1],\n        reverse=True\n    )[:top_n]\n\n    features, importances = zip(*sorted_features)\n\n    plt.figure(figsize=(10, 6))\n    plt.barh(range(len(features)), importances, color='steelblue')\n    plt.yticks(range(len(features)), features)\n    plt.xlabel('Importance')\n    plt.title(title)\n    plt.gca().invert_yaxis()\n    plt.tight_layout()\n    plt.show()\n\n\ndef categorize_features(feature_names):\n    \"\"\"Categorize features by type for better interpretation.\"\"\"\n    categories = {\n        'momentum': [],\n        'volatility': [],\n        'volume': [],\n        'trend': [],\n        'mtf': [],\n        'wavelet': [],\n        'microstructure': [],\n        'other': []\n    }\n\n    for feat in feature_names:\n        feat_lower = feat.lower()\n        if any(x in feat_lower for x in ['rsi', 'macd', 'roc', 'momentum', 'stoch']):\n            categories['momentum'].append(feat)\n        elif any(x in feat_lower for x in ['atr', 'bbands', 'volatility', 'std', 'keltner']):\n            categories['volatility'].append(feat)\n        elif any(x in feat_lower for x in ['volume', 'adv', 'vwap', 'obv', 'mfi']):\n            categories['volume'].append(feat)\n        elif any(x in feat_lower for x in ['sma', 'ema', 'adx', 'trend', 'dema', 'tema']):\n            categories['trend'].append(feat)\n        elif any(x in feat_lower for x in ['_5min', '_10min', '_15min', '_20min', '_25min', '_30min', '_45min', '_1h']):\n            categories['mtf'].append(feat)\n        elif 'wavelet' in feat_lower or 'db' in feat_lower:\n            categories['wavelet'].append(feat)\n        elif any(x in feat_lower for x in ['spread', 'imbalance', 'tick', 'depth']):\n            categories['microstructure'].append(feat)\n        else:\n            categories['other'].append(feat)\n\n    return categories\n\n\nprint(\"SHAP and feature importance utilities loaded.\")\n"
   ]
  },
