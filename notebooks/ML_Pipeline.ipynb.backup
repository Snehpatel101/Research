    "#@title 5.1 Run Cross-Validation { display-mode: \"form\" }\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from tqdm.auto import tqdm\n",
    "\n",
    "config = require_config()\n",
    "\n",
    "if not RUN_CROSS_VALIDATION:\n",
    "    print(\"[Skipped] Cross-validation disabled. Set RUN_CROSS_VALIDATION = True to enable.\")\n",
    "elif not config.data_ready:\n",
    "    print(\"[ERROR] Data not ready. Run Section 3 first.\")\n",
    "elif not config.training_results:\n",
    "    print(\"[ERROR] No trained models. Run Section 4 first.\")\n",
    "else:\n",
    "    print(\"=\" * 70)\n",
    "    print(\" PHASE 3: CROSS-VALIDATION\")\n",
    "    print(\"=\" * 70)\n",
    "    print(f\"\\n  Splits: {CV_N_SPLITS}\")\n",
    "    print(f\"  Tune Hyperparams: {CV_TUNE_HYPERPARAMS}\")\n",
    "    if CV_TUNE_HYPERPARAMS:\n",
    "        print(f\"  Trials: {CV_N_TRIALS}\")\n",
    "    \n",
    "    try:\n",
    "        from src.cross_validation import CrossValidationRunner\n",
    "        from src.phase1.stages.datasets.container import TimeSeriesDataContainer\n",
    "        \n",
    "        # Load data\n",
    "        container = TimeSeriesDataContainer.from_parquet_dir(\n",
    "            path=config.splits_dir,\n",
    "            horizon=config.training_horizon\n",
    "        )\n",
    "        \n",
    "        # Models to cross-validate (skip ensemble models)\n",
    "        cv_models = [\n",
    "            m for m in config.training_results.keys()\n",
    "            if m not in ('voting', 'stacking', 'blending') and 'error' not in config.training_results[m]\n",
    "        ]\n",
    "        \n",
    "        print(f\"\\n  Models: {cv_models}\")\n",
    "        \n",
    "        for model_name in tqdm(cv_models, desc=\"Cross-Validation\"):\n",
    "            print(f\"\\n>>> CV: {model_name}\")\n",
    "            \n",
    "            try:\n",
    "                cv_runner = CrossValidationRunner(\n",
    "                    model_name=model_name,\n",
    "                    n_splits=CV_N_SPLITS,\n",
    "                    purge_bars=PURGE_BARS,\n",
    "                    embargo_bars=EMBARGO_BARS,\n",
    "                )\n",
    "                \n",
    "                if CV_TUNE_HYPERPARAMS:\n",
    "                    cv_result = cv_runner.run_with_tuning(\n",
    "                        container,\n",
    "                        n_trials=CV_N_TRIALS\n",
    "                    )\n",
    "                else:\n",
    "                    cv_result = cv_runner.run(container)\n",
    "                \n",
    "                config.cv_results[model_name] = {\n",
    "                    'mean_accuracy': np.mean(cv_result.fold_accuracies),\n",
    "                    'std_accuracy': np.std(cv_result.fold_accuracies),\n",
    "                    'mean_f1': np.mean(cv_result.fold_f1s),\n",
    "                    'std_f1': np.std(cv_result.fold_f1s),\n",
    "                    'fold_results': cv_result.fold_results,\n",
    "                }\n",
    "                \n",
    "                print(f\"    Mean F1: {np.mean(cv_result.fold_f1s):.4f} +/- {np.std(cv_result.fold_f1s):.4f}\")\n",
    "                \n",
    "            except Exception as e:\n",
    "                print(f\"    [ERROR] {e}\")\n",
    "            \n",
    "            clear_memory(verbose=False)\n",
    "        \n",
    "        # Checkpoint\n",
    "        if config.is_colab:\n",
    "            save_checkpoint(config.cv_results, 'cv_complete')\n",
    "            \n",
    "    except Exception as e:\n",
    "        print(f\"\\n[ERROR] Cross-validation failed: {e}\")"
   ]
