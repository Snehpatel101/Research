   "source": [
    "#@title 4.1 Train Models { display-mode: \"form\" }",
    "",
    "import time",
    "import json",
    "from tqdm.auto import tqdm",
    "",
    "config = require_config()",
    "",
    "if not RUN_MODEL_TRAINING:",
    "    print(\"[Skipped] Model training disabled.\")",
    "elif not config.data_ready:",
    "    print(\"[ERROR] Data not ready. Run Section 3 first.\")",
    "elif not config.models_to_train:",
    "    print(\"[ERROR] No models selected. Enable models in Section 1.\")",
    "else:",
    "    print(\"=\" * 70)",
    "    print(\" PHASE 2: MODEL TRAINING\")",
    "    print(\"=\" * 70)",
    "    print(f\"\\n  Models: {config.models_to_train}\")",
    "    print(f\"  Horizon: H{config.training_horizon}\")",
    "    print(f\"  Batch Size: {config.batch_size}\")",
    "    print(f\"  Primary TF: {config.primary_timeframe}\")",
    "    if config.has_gpu:",
    "        print(f\"  GPU: {config.gpu_name}\")",
    "    ",
    "    # Model family mapping for TF config lookup",
    "    MODEL_FAMILY_MAP = {",
    "        # Boosting",
    "        'xgboost': 'boosting', 'lightgbm': 'boosting', 'catboost': 'boosting',",
    "        # Classical",
    "        'random_forest': 'boosting', 'logistic': 'boosting', 'svm': 'boosting',",
    "        # Neural sequence models",
    "        'lstm': 'neural', 'gru': 'neural', 'tcn': 'neural',",
    "        # Transformer models",
    "        'transformer': 'transformer', 'patchtst': 'transformer',",
    "        'itransformer': 'transformer', 'tft': 'transformer',",
    "        # Other neural",
    "        'nbeats': 'neural', 'inceptiontime': 'neural', 'resnet1d': 'neural',",
    "        # Ensemble (use boosting defaults)",
    "        'voting': 'boosting', 'stacking': 'boosting', 'blending': 'boosting',",
    "    }",
    "    ",
    "    try:",
    "        from src.models import ModelRegistry, Trainer, TrainerConfig",
    "        from src.phase1.stages.datasets.container import TimeSeriesDataContainer",
    "        ",
    "        # Load data container",
    "        print(\"\\nLoading data...\")",
    "        container = TimeSeriesDataContainer.from_parquet_dir(",
    "            path=config.splits_dir,",
    "            horizon=config.training_horizon",
    "        )",
    "        print(f\"  Train: {container.splits['train'].n_samples:,}\")",
    "        print(f\"  Val: {container.splits['val'].n_samples:,}\")",
    "        ",
    "        # Training loop",
    "        print(\"\\n\" + \"-\" * 70)",
    "        print(\" Training Models\")",
    "        print(\"-\" * 70)",
    "        ",
    "        models_trained = 0",
    "        ",
    "        for model_name in tqdm(config.models_to_train, desc=\"Training\"):",
    "            print(f\"\\n>>> Training: {model_name}\")",
    "            model_start = time.time()",
    "            ",
    "            try:",
    "                # Get model-specific TF config",
    "                model_family = MODEL_FAMILY_MAP.get(model_name, 'boosting')",
    "                tf_config = config.model_tf_config.get(model_family, {})",
    "                model_primary_tf = tf_config.get('primary_tf', config.primary_timeframe)",
    "                model_mtf_strategy = tf_config.get('mtf_strategy', config.mtf_strategy)",
    "                ",
    "                # Get feature selection config for this model family",
    "                feature_config = config.model_feature_config.get(model_family, {})",
    "                feature_set = feature_config.get('feature_set', 'auto')",
    "                ",
    "                print(f\"    Family: {model_family}, TF: {model_primary_tf}, MTF: {model_mtf_strategy}\")",
    "                print(f\"    Feature Set: {feature_set}\")",
    "                ",
    "                # Create trainer config with TF and feature settings",
    "                trainer_config = TrainerConfig(",
    "                    model_name=model_name,",
    "                    horizon=config.training_horizon,",
    "                    use_gpu=config.has_gpu,",
    "                    batch_size=config.batch_size,",
    "                    sequence_length=config.sequence_length,",
    "                    n_estimators=N_ESTIMATORS,",
    "                    early_stopping_rounds=BOOSTING_EARLY_STOPPING,",
    "                    max_epochs=MAX_EPOCHS,",
    "                    early_stopping_patience=EARLY_STOPPING_PATIENCE,",
    "                    use_class_weights=USE_CLASS_WEIGHTS,",
    "                    random_seed=RANDOM_SEED,",
    "                    # MTF settings (model-specific)",
    "                    primary_timeframe=model_primary_tf,",
    "                    mtf_strategy=model_mtf_strategy,",
    "                    # Feature selection settings (model-specific)",
    "                    feature_selection_mode=config.feature_selection_mode,",
    "                    feature_set=feature_set,",
    "                )",
    "                ",
    "                # Handle ensemble models",
    "                if model_name == 'voting':",
    "                    trainer_config.base_models = [m.strip() for m in VOTING_BASE_MODELS.split(',')]",
    "                elif model_name == 'stacking':",
    "                    trainer_config.base_models = [m.strip() for m in STACKING_BASE_MODELS.split(',')]",
    "                    trainer_config.meta_learner = STACKING_META_LEARNER",
    "                    trainer_config.n_folds = STACKING_N_FOLDS",
    "                elif model_name == 'blending':",
    "                    trainer_config.base_models = [m.strip() for m in BLENDING_BASE_MODELS.split(',')]",
    "                    trainer_config.meta_learner = BLENDING_META_LEARNER",
    "                    trainer_config.holdout_ratio = BLENDING_HOLDOUT_RATIO",
    "                ",
    "                # Train",
    "                trainer = Trainer(trainer_config)",
    "                result = trainer.train(container)",
    "                ",
    "                model_time = time.time() - model_start",
    "                ",
    "                # Store results",
    "                config.training_results[model_name] = {",
    "                    'metrics': result.metrics,",
    "                    'time': model_time,",
    "                    'run_id': result.run_id,",
    "                    'model_path': str(result.model_path),",
    "                    'val_predictions': result.val_predictions,",
    "                    'config': trainer_config.__dict__,",
    "                    'tf_config': {",
    "                        'primary_tf': model_primary_tf,",
    "                        'mtf_strategy': model_mtf_strategy,",
    "                        'family': model_family,",
    "                    },",
    "                    'feature_config': {",
    "                        'feature_selection_mode': config.feature_selection_mode,",
    "                        'feature_set': feature_set,",
    "                    },",
    "                }",
    "                ",
    "                print(f\"    Accuracy: {result.metrics.get('accuracy', 0):.4f}\")",
    "                print(f\"    Macro F1: {result.metrics.get('macro_f1', 0):.4f}\")",
    "                print(f\"    Time: {model_time:.1f}s\")",
    "                ",
    "                models_trained += 1",
    "\n                # Extract feature importance (tree models only)\n                if model_name in ['xgboost', 'lightgbm', 'catboost', 'random_forest']:\n                    try:\n                        # Get feature importance from model\n                        if hasattr(model, 'feature_importances_'):\n                            importance = model.feature_importances_\n                        elif hasattr(model, 'get_feature_importance'):  # CatBoost\n                            importance = model.get_feature_importance()\n                        else:\n                            importance = None\n\n                        if importance is not None:\n                            feature_names = container.feature_columns\n                            config.feature_importance[model_name] = {\n                                'importance': importance.tolist(),\n                                'features': feature_names,\n                                'top_10': sorted(\n                                    zip(feature_names, importance),\n                                    key=lambda x: x[1],\n                                    reverse=True\n                                )[:10]\n                            }\n                            print(f\"    \u2713 Feature importance extracted ({len(feature_names)} features)\")\n                    except Exception as e:\n                        print(f\"    [WARNING] Could not extract feature importance: {e}\")\n\n",
    "                ",
    "                # Checkpoint every N models (Colab)",
    "                if config.is_colab and models_trained % CHECKPOINT_INTERVAL == 0:",
    "                    save_checkpoint(",
    "                        config.training_results,",
    "                        f'training_checkpoint_{models_trained}'",
    "                    )",
    "                ",
    "            except Exception as e:",
    "                print(f\"    [ERROR] {model_name} failed: {e}\")",
    "                config.training_results[model_name] = {'error': str(e)}",
    "            ",
    "            # Clear memory between models",
    "            clear_memory(verbose=False)",
    "        ",
    "        print(\"\\n\" + \"=\" * 70)",
    "        print(f\" Training Complete: {models_trained}/{len(config.models_to_train)} models\")",
    "        print(\"=\" * 70)",
    "        ",
    "        # Final checkpoint",
    "        if config.is_colab:",
    "            save_checkpoint(config.training_results, 'training_complete')",
    "            ",
    "    except ImportError as e:",
    "        print(f\"\\n[ERROR] Import failed: {e}\")",
    "    except Exception as e:",
    "        print(f\"\\n[ERROR] Training failed: {e}\")",
    "        import traceback",
    "        traceback.print_exc()"
   ]
