   "source": [
    "---\n",
    "# 7. RESULTS & EXPORT\n",
    "\n",
    "Summary of all results and export options."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "#@title 7.1 Final Summary { display-mode: \"form\" }\n",
    "\n",
    "import pandas as pd\n",
    "\n",
    "config = require_config()\n",
    "\n",
    "print(\"=\" * 70)\n",
    "print(\" PIPELINE SUMMARY\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "print(f\"\\n  Runtime: {config.runtime_mode}\")\n",
    "print(f\"  Symbol: {config.symbol}\")\n",
    "print(f\"  Horizon: H{config.training_horizon}\")\n",
    "\n",
    "# Data summary\n",
    "print(\"\\n--- Data ---\")\n",
    "print(f\"  Data Ready: {config.data_ready}\")\n",
    "if config.data_start and config.data_end:\n",
    "    print(f\"  Date Range: {config.data_start.strftime('%Y-%m-%d')} to {config.data_end.strftime('%Y-%m-%d')}\")\n",
    "\n",
    "# Training summary\n",
    "print(\"\\n--- Training Results ---\")\n",
    "if config.training_results:\n",
    "    rows = []\n",
    "    for model, data in config.training_results.items():\n",
    "        if 'error' not in data:\n",
    "            metrics = data.get('metrics', {})\n",
    "            rows.append({\n",
    "                'Model': model,\n",
    "                'Val Acc': metrics.get('accuracy', 0),\n",
    "                'Val F1': metrics.get('macro_f1', 0),\n",
    "            })\n",
    "    \n",
    "    if rows:\n",
    "        df = pd.DataFrame(rows).sort_values('Val F1', ascending=False)\n",
    "        print(df.to_string(index=False))\n",
    "else:\n",
    "    print(\"  No models trained.\")\n",
    "\n",
    "# Test results\n",
    "if config.test_results:\n",
    "    print(\"\\n--- Test Results ---\")\n",
    "    rows = []\n",
    "    for model, data in config.test_results.items():\n",
    "        rows.append({\n",
    "            'Model': model,\n",
    "            'Test Acc': data.get('accuracy', 0),\n",
    "            'Test F1': data.get('macro_f1', 0),\n",
    "        })\n",
    "    df = pd.DataFrame(rows).sort_values('Test F1', ascending=False)\n",
    "    print(df.to_string(index=False))\n",
    "\n",
    "# CV results\n",
    "if config.cv_results:\n",
    "    print(\"\\n--- Cross-Validation Results ---\")\n",
    "    rows = []\n",
    "    for model, data in config.cv_results.items():\n",
    "        rows.append({\n",
    "            'Model': model,\n",
    "            'CV F1': f\"{data.get('mean_f1', 0):.4f} +/- {data.get('std_f1', 0):.4f}\",\n",
    "        })\n",
    "    df = pd.DataFrame(rows)\n",
    "    print(df.to_string(index=False))\n",
    "\n",
    "# Ensemble results\n",
    "if config.ensemble_results:\n",
    "    print(\"\\n--- Ensemble Results ---\")\n",
    "    for name, data in config.ensemble_results.items():\n",
    "        metrics = data.get('metrics', {})\n",
    "        print(f\"  {name}: Acc={metrics.get('accuracy', 0):.4f}, F1={metrics.get('macro_f1', 0):.4f}\")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "#@title 7.2 Export Results { display-mode: \"form\" }\n",
    "\n",
    "import json\n",
    "import shutil\n",
    "from datetime import datetime\n",
    "\n",
    "#@markdown ### Export Options\n",
    "export_models = True  #@param {type: \"boolean\"}\n",
    "export_selection = \"Best Model\"  #@param [\"Best Model\", \"All Models\", \"Top 3\"]\n",
    "create_zip = True  #@param {type: \"boolean\"}\n",
    "export_to_drive = True  #@param {type: \"boolean\"}\n",
    "\n",
    "config = require_config()\n",
    "\n",
    "if not export_models:\n",
    "    print(\"[Skipped] Export disabled.\")\n",
    "elif not config.training_results:\n",
    "    print(\"[ERROR] No results to export.\")\n",
    "else:\n",
    "    print(\"=\" * 70)\n",
    "    print(\" EXPORT RESULTS\")\n",
    "    print(\"=\" * 70)\n",
    "    \n",
    "    # Determine models to export\n",
    "    all_results = {**config.training_results, **config.ensemble_results}\n",
    "    successful = {k: v for k, v in all_results.items() if 'error' not in v}\n",
    "    \n",
    "    if export_selection == \"Best Model\":\n",
    "        best_model = max(successful, key=lambda x: successful[x]['metrics'].get('macro_f1', 0))\n",
    "        models_to_export = [best_model]\n",
    "    elif export_selection == \"Top 3\":\n",
    "        sorted_models = sorted(\n",
    "            successful.items(),\n",
    "            key=lambda x: x[1]['metrics'].get('macro_f1', 0),\n",
    "            reverse=True\n",
    "        )\n",
    "        models_to_export = [m[0] for m in sorted_models[:3]]\n",
    "    else:\n",
    "        models_to_export = list(successful.keys())\n",
    "    \n",
    "    print(f\"\\n  Exporting: {models_to_export}\")\n",
    "    \n",
    "    # Create export directory\n",
    "    timestamp = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n",
    "    export_dir = config.project_root / 'exports' / f\"{config.symbol}_H{config.training_horizon}_{timestamp}\"\n",
    "    export_dir.mkdir(parents=True, exist_ok=True)\n",
    "    \n",
    "    # Export each model\n",
    "    for model_name in models_to_export:\n",
    "        model_data = all_results[model_name]\n",
    "        model_export_dir = export_dir / model_name\n",
    "        model_export_dir.mkdir(exist_ok=True)\n",
    "        \n",
    "        # Copy model file\n",
    "        if 'model_path' in model_data:\n",
    "            src_path = Path(model_data['model_path'])\n",
    "            if src_path.exists():\n",
    "                shutil.copy2(src_path, model_export_dir / src_path.name)\n",
    "        \n",
    "        # Save metrics\n",
    "        metrics_file = model_export_dir / 'metrics.json'\n",
    "        with open(metrics_file, 'w') as f:\n",
    "            json.dump(model_data.get('metrics', {}), f, indent=2)\n",
    "        \n",
    "        print(f\"  Exported: {model_name}\")\n",
    "    \n",
    "    # Create ZIP\n",
    "    if create_zip:\n",
    "        zip_path = export_dir.parent / f\"{export_dir.name}.zip\"\n",
    "        shutil.make_archive(str(export_dir), 'zip', export_dir)\n",
    "        print(f\"\\n  ZIP created: {zip_path}\")\n",
    "    \n",
    "    # Copy to Drive\n",
    "    if export_to_drive and config.is_colab and config.drive_mounted:\n",
    "        drive_export_dir = Path('/content/drive/MyDrive/ml_exports')\n",
    "        drive_export_dir.mkdir(parents=True, exist_ok=True)\n",
    "        \n",
    "        if create_zip:\n",
    "            shutil.copy2(zip_path, drive_export_dir / zip_path.name)\n",
    "            print(f\"  Copied to Drive: {drive_export_dir / zip_path.name}\")\n",
    "    \n",
    "    print(f\"\\n  Export location: {export_dir}\")\n",
    "    print(\"\\n\" + \"=\" * 70)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "# Quick Reference\n",
    "\n",
    "## Command Line Usage\n",
    "\n",
    "```bash\n",
    "# Train single model\n",
    "python scripts/train_model.py --model xgboost --horizon 20\n",
    "\n",
    "# Train neural model\n",
    "python scripts/train_model.py --model lstm --horizon 20 --seq-len 60\n",
    "\n",
    "# Run cross-validation\n",
    "python scripts/run_cv.py --models xgboost,lightgbm --horizons 20 --n-splits 5\n",
    "\n",
    "# Train ensemble\n",
    "python scripts/train_model.py --model stacking --horizon 20 --base-models xgboost,lstm,tcn\n",
    "\n",
    "# List all available models\n",
    "python scripts/train_model.py --list-models\n",
    "```\n",
    "\n",
    "## Model Families (23 Models)\n",
    "\n",
    "| Family | Models | Best For |\n",
    "|--------|--------|----------|\n",
    "| Boosting (3) | XGBoost, LightGBM, CatBoost | Fast, accurate, tabular data |\n",
    "| Classical (3) | Random Forest, Logistic, SVM | Baselines, interpretability |\n",
    "| Neural (10) | LSTM, GRU, TCN, Transformer, PatchTST, iTransformer, TFT, N-BEATS, InceptionTime, ResNet1D | Sequential patterns |\n",
    "| Ensemble (3) | Voting, Stacking, Blending | Combined predictions |\n",
    "| Meta-Learners (4) | Ridge Meta, MLP Meta, Calibrated Meta, XGBoost Meta | Heterogeneous stacking |\n",
    "\n",
    "## Environment-Specific Behavior\n",
    "\n",
    "| Feature | Colab | Local GPU | Local CPU |\n",
    "|---------|-------|-----------|----------|\n",
    "| Drive Mounting | Yes | No | No |\n",
    "| Checkpoints | Drive + Local | Local | Local |\n",
    "| GPU Memory | 80% limit | Full | N/A |\n",
    "| Batch Size | Auto-scaled | Full | Reduced |"
   ]
  }
