    "#@title 5.5 CPCV + PBO Analysis (Overfitting Detection) { display-mode: \"form\" }\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "#@markdown ### CPCV Configuration\n",
    "#@markdown Combinatorially Purged Cross-Validation tests model robustness across\n",
    "#@markdown multiple train/test combinations, enabling PBO (Probability of Backtest\n",
    "#@markdown Overfitting) computation.\n",
    "run_cpcv_analysis = False  #@param {type: \"boolean\"}\n",
    "#@markdown Enable to run CPCV + PBO analysis\n",
    "n_groups = 10  #@param {type: \"integer\"}\n",
    "#@markdown Number of time groups to partition data into (more groups = more combinations)\n",
    "n_test_groups = 2  #@param {type: \"integer\"}\n",
    "#@markdown Number of groups held out as test per combination\n",
    "use_all_combos = False  #@param {type: \"boolean\"}\n",
    "#@markdown Use all combinations (can be slow) or limit to max_combinations\n",
    "max_combinations = 20  #@param {type: \"integer\"}\n",
    "#@markdown Maximum number of combinations to evaluate\n",
    "\n",
    "#@markdown ### PBO Thresholds\n",
    "pbo_warn_threshold = 0.5  #@param {type: \"number\"}\n",
    "#@markdown PBO above this threshold triggers a warning\n",
    "pbo_block_threshold = 0.8  #@param {type: \"number\"}\n",
    "#@markdown PBO above this threshold suggests blocking deployment\n",
    "\n",
    "config = require_config()\n",
    "\n",
    "if not run_cpcv_analysis:\n",
    "    print(\"[Skipped] CPCV + PBO analysis disabled. Set run_cpcv_analysis = True to enable.\")\n",
    "elif not config.data_ready:\n",
    "    print(\"[ERROR] Data not ready. Run Section 3 first.\")\n",
    "elif not config.training_results:\n",
    "    print(\"[ERROR] No trained models. Run Section 4 first.\")\n",
    "else:\n",
    "    print(\"=\" * 70)\n",
    "    print(\" CPCV + PBO ANALYSIS (Overfitting Detection)\")\n",
    "    print(\"=\" * 70)\n",
    "    print(f\"\\n  Groups: {n_groups}, Test Groups: {n_test_groups}\")\n",
    "    print(f\"  Max Combinations: {'All' if use_all_combos else max_combinations}\")\n",
    "    print(f\"  PBO Warn Threshold: {pbo_warn_threshold}\")\n",
    "    print(f\"  PBO Block Threshold: {pbo_block_threshold}\")\n",
    "    \n",
    "    try:\n",
    "        from tqdm.auto import tqdm\n",
    "        from sklearn.metrics import accuracy_score, f1_score\n",
    "        \n",
    "        from src.cross_validation.cpcv import CombinatorialPurgedCV, CPCVConfig, CPCVResult, CPCVPathResult\n",
    "        from src.cross_validation.pbo import compute_pbo, PBOConfig, PBOResult, pbo_gate, analyze_overfitting_risk\n",
    "        from src.phase1.stages.datasets.container import TimeSeriesDataContainer\n",
    "        from src.models import ModelRegistry\n",
    "        \n",
    "        # Load data\n",
    "        print(\"\\nLoading data...\")\n",
    "        container = TimeSeriesDataContainer.from_parquet_dir(\n",
    "            path=config.splits_dir,\n",
    "            horizon=config.training_horizon\n",
    "        )\n",
    "        \n",
    "        # Use combined train + val for CPCV (test set remains held out)\n",
    "        train_split = container.splits['train']\n",
    "        val_split = container.splits['val']\n",
    "        \n",
    "        # Combine train and val features/labels\n",
    "        X_combined = np.vstack([train_split.features, val_split.features])\n",
    "        y_combined = np.concatenate([train_split.labels, val_split.labels])\n",
    "        \n",
    "        # Convert to DataFrame for CPCV (needs index)\n",
    "        X_df = pd.DataFrame(X_combined)\n",
    "        y_series = pd.Series(y_combined)\n",
    "        \n",
    "        print(f\"  Combined data: {len(X_combined):,} samples\")\n",
    "        print(f\"  Shape: {X_combined.shape}\")\n",
    "        \n",
    "        # Create CPCV config\n",
    "        cpcv_config = CPCVConfig(\n",
    "            n_groups=n_groups,\n",
    "            n_test_groups=n_test_groups,\n",
    "            max_combinations=100 if use_all_combos else max_combinations,\n",
    "            purge_pct=PURGE_BARS / len(X_combined),\n",
    "            embargo_pct=EMBARGO_BARS / len(X_combined),\n",
    "        )\n",
    "        \n",
    "        cpcv = CombinatorialPurgedCV(cpcv_config)\n",
    "        n_paths = cpcv.get_n_splits(X_df)\n",
    "        print(f\"  CPCV Paths: {n_paths} combinations\")\n",
    "        \n",
    "        # Models to evaluate (skip ensembles, they are too slow for CPCV)\n",
    "        cpcv_models = [\n",
    "            m for m in config.training_results.keys()\n",
    "            if m not in ('voting', 'stacking', 'blending') \n",
    "            and 'error' not in config.training_results[m]\n",
    "        ][:5]  # Limit to 5 models for speed\n",
    "        \n",
    "        print(f\"  Models to evaluate: {cpcv_models}\")\n",
    "        print(\"\\n\" + \"-\" * 70)\n",
    "        \n",
    "        # Collect performance matrix for PBO\n",
    "        # Shape: (n_models, n_paths) where each entry is the Sharpe or accuracy\n",
    "        all_cpcv_results = {}\n",
    "        performance_matrix = []\n",
    "        \n",
    "        for model_name in tqdm(cpcv_models, desc=\"CPCV Evaluation\"):\n",
    "            print(f\"\\n>>> {model_name}\")\n",
    "            \n",
    "            try:\n",
    "                # Get model class and path\n",
    "                model_data = config.training_results[model_name]\n",
    "                model_path = model_data.get('model_path')\n",
    "                \n",
    "                if not model_path:\n",
    "                    print(f\"    [Skipped] No model path found\")\n",
    "                    continue\n",
    "                \n",
    "                model_class = ModelRegistry.get(model_name)\n",
    "                path_results = []\n",
    "                path_accuracies = []\n",
    "                \n",
    "                for train_idx, test_idx, path_id in cpcv.split(X_df, y_series):\n",
    "                    # Create fresh model instance for each path\n",
    "                    model = model_class()\n",
    "                    \n",
    "                    # Get train/test data\n",
    "                    X_train_path = X_combined[train_idx]\n",
    "                    y_train_path = y_combined[train_idx]\n",
    "                    X_test_path = X_combined[test_idx]\n",
    "                    y_test_path = y_combined[test_idx]\n",
    "                    \n",
    "                    # Train model on this path\n",
    "                    try:\n",
    "                        # Use a subset for validation if needed\n",
    "                        val_size = min(1000, len(X_train_path) // 5)\n",
    "                        X_val_path = X_train_path[-val_size:]\n",
    "                        y_val_path = y_train_path[-val_size:]\n",
    "                        X_train_actual = X_train_path[:-val_size]\n",
    "                        y_train_actual = y_train_path[:-val_size]\n",
    "                        \n",
    "                        model.fit(\n",
    "                            X_train_actual, y_train_actual,\n",
    "                            X_val_path, y_val_path,\n",
    "                        )\n",
    "                        \n",
    "                        # Predict on test\n",
    "                        predictions = model.predict(X_test_path)\n",
    "                        y_pred = predictions.classes\n",
    "                        \n",
    "                        # Calculate metrics\n",
    "                        acc = accuracy_score(y_test_path, y_pred)\n",
    "                        f1 = f1_score(y_test_path, y_pred, average='macro')\n",
    "                        \n",
    "                        # Simple proxy Sharpe: (acc - 0.33) / 0.1 (normalized around random baseline)\n",
    "                        sharpe_proxy = (acc - 0.33) / 0.1 if acc > 0.33 else 0.0\n",
    "                        \n",
    "                        path_result = CPCVPathResult(\n",
    "                            path_id=path_id,\n",
    "                            test_groups=tuple(),  # Not tracked for simplicity\n",
    "                            train_size=len(train_idx),\n",
    "                            test_size=len(test_idx),\n",
    "                            train_groups=tuple(),\n",
    "                            accuracy=acc,\n",
    "                            f1=f1,\n",
    "                            sharpe=sharpe_proxy,\n",
    "                        )\n",
    "                        path_results.append(path_result)\n",
    "                        path_accuracies.append(acc)\n",
    "                        \n",
    "                    except Exception as e:\n",
    "                        # Skip failed paths\n",
    "                        path_accuracies.append(0.33)  # Random baseline\n",
    "                \n",
    "                # Store results\n",
    "                if path_results:\n",
    "                    cpcv_result = CPCVResult(\n",
    "                        config=cpcv_config,\n",
    "                        path_results=path_results,\n",
    "                        model_name=model_name,\n",
    "                        horizon=config.training_horizon,\n",
    "                    )\n",
    "                    all_cpcv_results[model_name] = cpcv_result\n",
    "                    performance_matrix.append(path_accuracies)\n",
    "                    \n",
    "                    print(f\"    Mean Accuracy: {cpcv_result.mean_accuracy:.4f} (+/- {cpcv_result.std_accuracy:.4f})\")\n",
    "                    print(f\"    Paths evaluated: {len(path_results)}\")\n",
    "                \n",
    "            except Exception as e:\n",
    "                print(f\"    [ERROR] {e}\")\n",
    "            \n",
    "            clear_memory(verbose=False)\n",
    "        \n",
    "        # Compute PBO if we have multiple models\n",
    "        if len(performance_matrix) >= 2:\n",
    "            print(\"\\n\" + \"=\" * 70)\n",
    "            print(\" PROBABILITY OF BACKTEST OVERFITTING (PBO)\")\n",
    "            print(\"=\" * 70)\n",
    "            \n",
    "            # Convert to numpy array\n",
    "            perf_matrix = np.array(performance_matrix)\n",
    "            print(f\"\\n  Performance matrix shape: {perf_matrix.shape}\")\n",
    "            print(f\"  (n_models={perf_matrix.shape[0]}, n_paths={perf_matrix.shape[1]})\")\n",
    "            \n",
    "            # Compute PBO\n",
    "            pbo_config = PBOConfig(\n",
    "                n_partitions=min(16, perf_matrix.shape[1]),\n",
    "                warn_threshold=pbo_warn_threshold,\n",
    "                block_threshold=pbo_block_threshold,\n",
    "                min_paths=max(6, perf_matrix.shape[1] // 2),\n",
    "            )\n",
    "            \n",
    "            try:\n",
    "                pbo_result = compute_pbo(perf_matrix, pbo_config)\n",
    "                \n",
    "                print(f\"\\n  PBO: {pbo_result.pbo:.3f}\")\n",
    "                print(f\"  Risk Level: {pbo_result.get_risk_level()}\")\n",
    "                print(f\"  Performance Degradation: {pbo_result.performance_degradation:.2%}\")\n",
    "                print(f\"  Rank Correlation (IS vs OOS): {pbo_result.rank_correlation:.3f}\")\n",
    "                print(f\"  Best IS Model Index: {pbo_result.best_is_strategy_idx}\")\n",
    "                print(f\"  Best IS Model OOS Rank: {pbo_result.best_is_oos_rank:.2f}\")\n",
    "                \n",
    "                # Interpret PBO\n",
    "                print(\"\\n--- PBO Interpretation ---\")\n",
    "                if pbo_result.pbo < 0.3:\n",
    "                    print(\"  [OK] Low overfitting risk. Model selection appears robust.\")\n",
    "                elif pbo_result.pbo < pbo_warn_threshold:\n",
    "                    print(\"  [CAUTION] Some overfitting signal. Review model diversity.\")\n",
    "                elif pbo_result.pbo < pbo_block_threshold:\n",
    "                    print(\"  [WARNING] Moderate overfitting risk. Reconsider model selection.\")\n",
    "                else:\n",
    "                    print(\"  [CRITICAL] High overfitting risk. DO NOT deploy without further validation.\")\n",
    "                \n",
    "                # Store PBO results\n",
    "                config.cpcv_results['pbo'] = pbo_result.to_dict()\n",
    "                \n",
    "                # Use pbo_gate for deployment decision\n",
    "                should_proceed, reason = pbo_gate(pbo_result, strict=False)\n",
    "                print(f\"\\n  Deployment Gate: {'PASS' if should_proceed else 'FAIL'}\")\n",
    "                print(f\"  Reason: {reason}\")\n",
    "                \n",
    "            except Exception as e:\n",
    "                print(f\"\\n  [ERROR] PBO computation failed: {e}\")\n",
    "                print(\"  (Need at least 6 paths and 2 models for reliable PBO)\")\n",
    "        \n",
    "        else:\n",
    "            print(\"\\n[WARNING] Need at least 2 models for PBO computation\")\n",
    "        \n",
    "        # Store CPCV results\n",
    "        config.cpcv_results['models'] = {\n",
    "            name: result.to_dict() \n",
    "            for name, result in all_cpcv_results.items()\n",
    "        }\n",
    "        \n",
    "        # Summary visualization\n",
    "        if all_cpcv_results:\n",
    "            print(\"\\n\" + \"=\" * 70)\n",
    "            print(\" CPCV SUMMARY\")\n",
    "            print(\"=\" * 70)\n",
    "            \n",
    "            # Summary table\n",
    "            rows = []\n",
    "            for name, result in all_cpcv_results.items():\n",
    "                rows.append({\n",
    "                    'Model': name,\n",
    "                    'Mean Acc': f\"{result.mean_accuracy:.4f}\",\n",
    "                    'Std Acc': f\"{result.std_accuracy:.4f}\",\n",
    "                    'Mean Sharpe': f\"{result.mean_sharpe:.2f}\",\n",
    "                    'Paths': result.n_paths,\n",
    "                })\n",
    "            \n",
    "            summary_df = pd.DataFrame(rows)\n",
    "            summary_df = summary_df.sort_values('Mean Acc', ascending=False)\n",
    "            print(\"\\n\")\n",
    "            print(summary_df.to_string(index=False))\n",
    "            \n",
    "            # Plot accuracy distribution\n",
    "            fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "            \n",
    "            # Box plot of accuracies across paths\n",
    "            ax1 = axes[0]\n",
    "            accuracies_per_model = [\n",
    "                [pr.accuracy for pr in result.path_results]\n",
    "                for result in all_cpcv_results.values()\n",
    "            ]\n",
    "            model_names = list(all_cpcv_results.keys())\n",
    "            ax1.boxplot(accuracies_per_model, labels=model_names)\n",
    "            ax1.set_ylabel('Accuracy')\n",
    "            ax1.set_title('CPCV Accuracy Distribution by Model')\n",
    "            ax1.axhline(y=0.33, color='r', linestyle='--', alpha=0.5, label='Random baseline')\n",
    "            ax1.legend()\n",
    "            ax1.tick_params(axis='x', rotation=45)\n",
    "            \n",
    "            # Performance degradation scatter (if PBO computed)\n",
    "            ax2 = axes[1]\n",
    "            if 'pbo' in config.cpcv_results:\n",
    "                # Plot IS vs OOS performance comparison\n",
    "                is_means = [np.mean([pr.accuracy for pr in result.path_results]) for result in all_cpcv_results.values()]\n",
    "                oos_stds = [np.std([pr.accuracy for pr in result.path_results]) for result in all_cpcv_results.values()]\n",
    "                \n",
    "                ax2.scatter(is_means, oos_stds, s=100, alpha=0.7)\n",
    "                for i, name in enumerate(model_names):\n",
    "                    ax2.annotate(name, (is_means[i], oos_stds[i]), fontsize=9)\n",
    "                ax2.set_xlabel('Mean Accuracy')\n",
    "                ax2.set_ylabel('Accuracy Std Dev')\n",
    "                ax2.set_title('Model Stability: Mean vs Variance')\n",
    "                ax2.axvline(x=0.33, color='r', linestyle='--', alpha=0.5)\n",
    "            \n",
    "            plt.tight_layout()\n",
    "            plt.show()\n",
    "        \n",
    "        # Checkpoint\n",
    "        if config.is_colab:\n",
    "            save_checkpoint(config.cpcv_results, 'cpcv_pbo_complete')\n",
    "        \n",
    "        del container, X_combined, y_combined\n",
    "        clear_memory(verbose=False)\n",
    "        \n",
    "    except ImportError as e:\n",
    "        print(f\"\\n[ERROR] Import failed: {e}\")\n",
    "        print(\"Ensure src/cross_validation/cpcv.py and pbo.py exist.\")\n",
    "    except Exception as e:\n",
    "        print(f\"\\n[ERROR] CPCV + PBO analysis failed: {e}\")\n",
    "        import traceback\n",
    "        traceback.print_exc()\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "# 6. PHASE 4: ENSEMBLE (Optional)\n",
    "\n",
    "Combine multiple models for improved predictions."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "#@title 6.1 Train Ensemble { display-mode: \"form\" }\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "#@markdown ### Ensemble Options\n",
    "show_diversity_analysis = True  #@param {type: \"boolean\"}\n",
    "min_base_models = 2  #@param {type: \"integer\"}\n",
    "\n",
    "config = require_config()\n",
    "\n",
    "if not TRAIN_ENSEMBLE:\n",
    "    print(\"[Skipped] Ensemble training disabled. Set TRAIN_ENSEMBLE = True to enable.\")\n",
    "elif not config.data_ready:\n",
    "    print(\"[ERROR] Data not ready. Run Section 3 first.\")\n",
    "elif len(config.training_results) < min_base_models:\n",
    "    print(f\"[ERROR] Need at least {min_base_models} trained base models for ensemble.\")\n",
    "else:\n",
    "    print(\"=\" * 70)\n",
    "    print(\" PHASE 4: ENSEMBLE TRAINING\")\n",
    "    print(\"=\" * 70)\n",
    "    print(f\"\\n  Ensemble Type: {ENSEMBLE_TYPE}\")\n",
    "    \n",
    "    # Get available base models\n",
    "    base_models = [\n",
    "        m for m in config.training_results.keys()\n",
    "        if m not in ('voting', 'stacking', 'blending') and 'error' not in config.training_results[m]\n",
    "    ]\n",
    "    print(f\"  Available Base Models: {base_models}\")\n",
    "    \n",
    "    try:\n",
    "        from src.models import ModelRegistry, Trainer, TrainerConfig\n",
    "        from src.phase1.stages.datasets.container import TimeSeriesDataContainer\n",
    "        \n",
    "        # Load data\n",
    "        container = TimeSeriesDataContainer.from_parquet_dir(\n",
    "            path=config.splits_dir,\n",
    "            horizon=config.training_horizon\n",
    "        )\n",
    "        \n",
    "        # Train ensemble\n",
    "        trainer_config = TrainerConfig(\n",
    "            model_name=ENSEMBLE_TYPE,\n",
    "            horizon=config.training_horizon,\n",
    "            use_gpu=config.has_gpu,\n",
    "            base_models=base_models[:5],  # Limit to 5 base models\n",
    "            meta_learner=ENSEMBLE_META_LEARNER,\n",
    "            random_seed=RANDOM_SEED,\n",
    "        )\n",
    "        \n",
    "        trainer = Trainer(trainer_config)\n",
    "        result = trainer.train(container)\n",
    "        \n",
    "        config.ensemble_results[ENSEMBLE_TYPE] = {\n",
    "            'metrics': result.metrics,\n",
    "            'run_id': result.run_id,\n",
    "            'base_models': base_models[:5],\n",
    "        }\n",
    "        \n",
    "        print(f\"\\n  Ensemble Accuracy: {result.metrics.get('accuracy', 0):.4f}\")\n",
    "        print(f\"  Ensemble Macro F1: {result.metrics.get('macro_f1', 0):.4f}\")\n",
    "        \n",
    "        # Diversity analysis\n",
    "        if show_diversity_analysis and hasattr(result, 'diversity_metrics'):\n",
    "            print(\"\\n  Diversity Metrics:\")\n",
    "            for metric, value in result.diversity_metrics.items():\n",
    "                print(f\"    {metric}: {value:.4f}\")\n",
    "        \n",
    "        # Checkpoint\n",
    "        if config.is_colab:\n",
    "            save_checkpoint(config.ensemble_results, 'ensemble_complete')\n",
    "            \n",
    "    except Exception as e:\n",
    "        print(f\"\\n[ERROR] Ensemble training failed: {e}\")\n",
    "        import traceback\n",
    "        traceback.print_exc()"
   ]
  },
  {
   "cell_type": "markdown",
