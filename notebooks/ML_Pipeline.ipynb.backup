    "#@title 2.1 Initialize Environment & CONFIG { display-mode: \"form\" }",
    "",
    "import os",
    "import sys",
    "import gc",
    "import json",
    "import time",
    "import shutil",
    "import psutil",
    "import subprocess",
    "from pathlib import Path",
    "from datetime import datetime",
    "from dataclasses import dataclass, field",
    "from typing import Optional, List, Dict, Any",
    "import numpy as np",
    "",
    "from notebooks.colab_setup import is_colab, setup_environment, _git_repo_root",
    "",
    "# ============================================================",
    "# NOTEBOOK CONFIG DATACLASS",
    "# ============================================================",
    "",
    "@dataclass",
    "class NotebookConfig:",
    "    \"\"\"Unified configuration object for the entire notebook.",
    "    ",
    "    This single CONFIG object is created once in Cell 2 and used by all",
    "    subsequent cells. No more repeated get_project_root() or if-checks.",
    "    \"\"\"",
    "    # Runtime",
    "    runtime_mode: str",
    "    is_colab: bool",
    "    has_gpu: bool",
    "    gpu_name: Optional[str] = None",
    "    gpu_memory_gb: float = 0.0",
    "    ",
    "    # Paths",
    "    project_root: Path = field(default_factory=Path)",
    "    raw_data_dir: Path = field(default_factory=Path)",
    "    splits_dir: Path = field(default_factory=Path)",
    "    experiments_dir: Path = field(default_factory=Path)",
    "    checkpoint_dir: Path = field(default_factory=Path)",
    "    ",
    "    # Data",
    "    symbol: str = \"MGC\"",
    "    raw_data_file: Optional[Path] = None",
    "    data_start: Optional[datetime] = None",
    "    data_end: Optional[datetime] = None",
    "    ",
    "    # Training",
    "    horizon_list: List[int] = field(default_factory=lambda: [5, 10, 15, 20])",
    "    training_horizon: int = 20",
    "    models_to_train: List[str] = field(default_factory=list)",
    "    sequence_length: int = 60",
    "    batch_size: int = 256",
    "    ",
    "    # MTF Configuration",
    "    primary_timeframe: str = \"5min\"",
    "    mtf_strategy: str = \"default\"",
    "    mtf_timeframes: List[str] = field(default_factory=list)",
    "    mtf_mode: str = \"both\"",
    "    model_tf_config: Dict[str, Dict[str, str]] = field(default_factory=dict)",
    "    ",
    "    # Feature Selection Configuration",
    "    feature_selection_mode: str = \"auto\"",
    "    manual_feature_count: int = 50",
    "    tabular_feature_set: str = \"boosting_optimal\"",
    "    sequence_feature_set: str = \"sequence_raw\"",
    "    transformer_feature_set: str = \"raw_ohlcv\"",
    "    model_feature_config: Dict[str, Dict[str, Any]] = field(default_factory=dict)",
    "    ",
    "    # Regime detection",
    "    regime_labels: Optional[np.ndarray] = None",
    "    regime_probabilities: Optional[np.ndarray] = None",
    "\n    # Explainability results\n    shap_results: Dict[str, Any] = field(default_factory=dict)\n    feature_importance: Dict[str, Any] = field(default_factory=dict)\n",
    "    n_regimes: int = 4",
    "    regime_names: List[str] = field(default_factory=lambda: [\"low_vol\", \"normal\", \"high_vol\", \"crisis\"])",
    "    ",
    "    # State tracking",
    "    data_ready: bool = False",
    "    drive_mounted: bool = False",
    "    packages_installed: bool = False",
    "    ",
    "    # Trading simulation\n",
    "    trading_sim_results: Dict[str, Any] = field(default_factory=dict)\n",
    "    position_sizing_method: str = \"kelly\"\n",
    "    initial_capital: float = 100000.0\n",
    "    \n",
    "    # Results storage",
    "    training_results: Dict[str, Any] = field(default_factory=dict)",
    "    cv_results: Dict[str, Any] = field(default_factory=dict)",
    "    ensemble_results: Dict[str, Any] = field(default_factory=dict)",
    "    test_results: Dict[str, Any] = field(default_factory=dict)",
    "    wf_results: Dict[str, Any] = field(default_factory=dict)",
    "    cpcv_results: Dict[str, Any] = field(default_factory=dict)",
    "    ",
    "    def __post_init__(self):",
    "        \"\"\"Validate configuration after initialization.\"\"\"",
    "        if self.training_horizon not in self.horizon_list:",
    "            raise ValueError(",
    "                f\"training_horizon={self.training_horizon} not in horizon_list={self.horizon_list}\"",
    "            )",
    "    ",
    "    def summary(self) -> str:",
    "        \"\"\"Return configuration summary string.\"\"\"",
    "        lines = [",
    "            \"=\" * 70,",
    "            \" NOTEBOOK CONFIGURATION\",",
    "            \"=\" * 70,",
    "            f\"\\n  Runtime Mode:    {self.runtime_mode}\",",
    "            f\"  Is Colab:        {self.is_colab}\",",
    "            f\"  Has GPU:         {self.has_gpu}\",",
    "        ]",
    "        if self.gpu_name:",
    "            lines.append(f\"  GPU:             {self.gpu_name} ({self.gpu_memory_gb:.1f} GB)\")",
    "        lines.extend([",
    "            f\"\\n  Project Root:    {self.project_root}\",",
    "            f\"  Raw Data Dir:    {self.raw_data_dir}\",",
    "            f\"  Splits Dir:      {self.splits_dir}\",",
    "            f\"\\n  Symbol:          {self.symbol}\",",
    "            f\"  Horizons:        {self.horizon_list}\",",
    "            f\"  Training Horizon: H{self.training_horizon}\",",
    "            f\"  Models:          {self.models_to_train if self.models_to_train else 'None selected'}\",",
    "            f\"\\n  Primary TF:      {self.primary_timeframe}\",",
    "            f\"  MTF Strategy:    {self.mtf_strategy}\",",
    "            f\"  MTF Timeframes:  {self.mtf_timeframes if self.mtf_timeframes else 'None (single-TF)'}\",",
    "            f\"  MTF Mode:        {self.mtf_mode}\",",
    "            f\"\\n  Feature Selection: {self.feature_selection_mode}\",",
    "            f\"  Data Ready:      {self.data_ready}\",",
    "            \"=\" * 70,",
    "        ])",
    "        return \"\\n\".join(lines)",
    "",
    "# ============================================================",
    "# CREATE CONFIG",
    "# ============================================================",
    "",
    "def _resolve_repo_root_override() -> Optional[str]:",
    "    \"\"\"Resolve repo root with improved auto-detection for local runtimes.",
    "    ",
    "    Priority:",
    "    1. Explicit REPO_ROOT override (if set)",
    "    2. For colab_hosted: COLAB_PROJECT_PATH",
    "    3. For local (including \"Connect to local runtime\"): ",
    "       - LOCAL_PROJECT_ROOT if set",
    "       - Otherwise auto-detect via git repo root",
    "    4. For auto mode: detect environment and apply above rules",
    "    \"\"\"",
    "    # 1. Explicit override always wins",
    "    if REPO_ROOT.strip():",
    "        return REPO_ROOT.strip()",
    "    ",
    "    # 2. Colab hosted mode",
    "    if RUNTIME_TARGET == \"colab_hosted\":",
    "        return COLAB_PROJECT_PATH if COLAB_PROJECT_PATH else None",
    "    ",
    "    # 3. Local mode (includes \"Connect to local runtime\" from Colab UI)",
    "    if RUNTIME_TARGET == \"local\":",
    "        if LOCAL_PROJECT_ROOT.strip():",
    "            return LOCAL_PROJECT_ROOT.strip()",
    "        # Auto-detect: use git repo root from current working directory",
    "        detected = _git_repo_root(Path.cwd())",
    "        if detected:",
    "            return str(detected)",
    "        # Fallback: check if notebooks/ parent has src/",
    "        notebook_dir = Path(__file__).parent if '__file__' in dir() else Path.cwd()",
    "        if (notebook_dir.parent / 'src').exists():",
    "            return str(notebook_dir.parent)",
    "        return None",
    "    ",
    "    # 4. Auto mode - detect environment",
    "    if RUNTIME_TARGET == \"auto\":",
    "        if is_colab():",
    "            # Running in actual Colab environment",
    "            return COLAB_PROJECT_PATH if COLAB_PROJECT_PATH else None",
    "        else:",
    "            # Local environment (Jupyter, local Colab kernel, etc.)",
    "            if LOCAL_PROJECT_ROOT.strip():",
    "                return LOCAL_PROJECT_ROOT.strip()",
    "            # Auto-detect via git",
    "            detected = _git_repo_root(Path.cwd())",
    "            if detected:",
    "                return str(detected)",
    "            return None",
    "    ",
    "    return None",
    "",
    "",
    "def create_config() -> NotebookConfig:",
    "    \"\"\"Create and initialize the notebook configuration.\"\"\"",
    "    repo_root_override = _resolve_repo_root_override()",
    "",
    "    env = setup_environment(",
    "        runtime_target=RUNTIME_TARGET,",
    "        repo_root=repo_root_override,",
    "        mount_drive=USE_DRIVE,",
    "        use_gpu=True,",
    "        repo_url=GITHUB_REPO_URL if GITHUB_REPO_URL else None,",
    "    )",
    "",
    "    runtime = env[\"runtime_mode\"]",
    "    is_colab_runtime = env[\"is_colab\"]",
    "    has_gpu = env[\"gpu_available\"]",
    "",
    "    # GPU detection",
    "    gpu_name = env.get(\"gpu_name\")",
    "    gpu_memory = 0.0",
    "    if has_gpu:",
    "        try:",
    "            import torch",
    "            if torch.cuda.is_available():",
    "                props = torch.cuda.get_device_properties(0)",
    "                gpu_name = props.name",
    "                gpu_memory = props.total_memory / (1024**3)",
    "        except Exception:",
    "            has_gpu = False",
    "",
    "    project_root = Path(env[\"repo_root\"])",
    "",
    "    # Paths",
    "    if is_colab_runtime and USE_DRIVE and env.get(\"drive_mounted\"):",
    "        raw_data_dir = Path(env[\"drive_root\"]) / DRIVE_DATA_PATH",
    "    else:",
    "        raw_data_dir = project_root / LOCAL_DATA_PATH",
    "",
    "    splits_dir = project_root / 'data/splits/scaled'",
    "    experiments_dir = project_root / 'experiments/runs'",
    "    checkpoint_dir = project_root / 'checkpoints'",
    "",
    "    # Adjust batch size based on GPU",
    "    batch_size = BATCH_SIZE",
    "    if has_gpu and gpu_memory >= 12:",
    "        batch_size = max(BATCH_SIZE, 512)  # RTX 4070 Ti has 12GB",
    "    elif has_gpu and gpu_memory >= 40:",
    "        batch_size = max(BATCH_SIZE, 1024)  # A100 has 40/80GB",
    "",
    "    config = NotebookConfig(",
    "        runtime_mode=runtime,",
    "        is_colab=is_colab_runtime,",
    "        has_gpu=has_gpu,",
    "        gpu_name=gpu_name,",
    "        gpu_memory_gb=gpu_memory,",
    "        project_root=project_root,",
    "        raw_data_dir=raw_data_dir,",
    "        splits_dir=splits_dir,",
    "        experiments_dir=experiments_dir,",
    "        checkpoint_dir=checkpoint_dir,",
    "        symbol=SYMBOL,",
    "        horizon_list=HORIZON_LIST,",
    "        training_horizon=TRAINING_HORIZON,",
    "        models_to_train=MODELS_TO_TRAIN.copy(),",
    "        sequence_length=SEQUENCE_LENGTH,",
    "        batch_size=batch_size,",
    "        # MTF config",
    "        primary_timeframe=PRIMARY_TIMEFRAME,",
    "        mtf_strategy=MTF_STRATEGY,",
    "        mtf_timeframes=MTF_TIMEFRAMES,",
    "        mtf_mode=MTF_MODE,",
    "        model_tf_config=MODEL_TF_CONFIG,",
    "        # Feature selection config",
    "        feature_selection_mode=FEATURE_SELECTION_MODE,",
    "        manual_feature_count=MANUAL_FEATURE_COUNT,",
    "        tabular_feature_set=TABULAR_FEATURE_SET,",
    "        sequence_feature_set=SEQUENCE_FEATURE_SET,",
    "        transformer_feature_set=TRANSFORMER_FEATURE_SET,",
    "        model_feature_config=MODEL_FEATURE_CONFIG,",
    "    )",
    "",
    "    config.drive_mounted = bool(env.get(\"drive_mounted\"))",
    "",
    "    return config",
    "",
    "# ============================================================",
    "# GPU OPTIMIZATION",
    "# ============================================================",
    "",
    "def optimize_gpu(config: NotebookConfig) -> None:",
    "    \"\"\"Apply GPU optimizations based on environment.\"\"\"",
    "    if not config.has_gpu:",
    "        return",
    "    ",
    "    import torch",
    "    ",
    "    # Clear cache",
    "    torch.cuda.empty_cache()",
    "    ",
    "    if config.is_colab:",
    "        # Colab: conservative memory fraction",
    "        torch.cuda.set_per_process_memory_fraction(0.8)",
    "        print(\"  [GPU] Memory fraction set to 80% (Colab)\")",
    "    else:",
    "        # Local: use full GPU memory",
    "        # Don't set fraction - let PyTorch use all available memory",
    "        print(f\"  [GPU] Using full memory: {config.gpu_memory_gb:.1f} GB\")",
    "    ",
    "    # TF32 for Ampere+ GPUs",
    "    props = torch.cuda.get_device_properties(0)",
    "    if props.major >= 8:",
    "        torch.backends.cuda.matmul.allow_tf32 = True",
    "        torch.backends.cudnn.allow_tf32 = True",
    "        print(\"  [GPU] TF32 enabled (Ampere+ GPU)\")",
    "    ",
    "    # cuDNN benchmark",
    "    torch.backends.cudnn.benchmark = True",
    "    print(\"  [GPU] cuDNN benchmark enabled\")",
    "",
    "# ============================================================",
    "# UTILITY FUNCTIONS (stored in CONFIG for easy access)",
    "# ============================================================",
    "",
    "def clear_memory(verbose: bool = True) -> None:",
    "    \"\"\"Clear RAM and GPU memory.\"\"\"",
    "    gc.collect()",
    "    try:",
    "        import torch",
    "        if torch.cuda.is_available():",
    "            torch.cuda.empty_cache()",
    "            torch.cuda.synchronize()",
    "    except Exception:",
    "        pass",
    "    if verbose:",
    "        print(\"Memory cleared.\")",
    "",
    "def print_memory_status(label: str = \"Current\") -> None:",
    "    \"\"\"Print current memory usage.\"\"\"",
    "    print(f\"\\n--- Memory: {label} ---\")",
    "    ram = psutil.virtual_memory()",
    "    print(f\"RAM: {ram.used/1e9:.1f}GB / {ram.total/1e9:.1f}GB ({ram.percent}%)\")",
    "    try:",
    "        import torch",
    "        if torch.cuda.is_available():",
    "            allocated = torch.cuda.memory_allocated() / 1e9",
    "            total = torch.cuda.get_device_properties(0).total_memory / 1e9",
    "            print(f\"GPU: {allocated:.2f}GB / {total:.1f}GB\")",
    "    except Exception:",
    "        pass",
    "",
    "# ============================================================",
    "# INITIALIZE CONFIG",
    "# ============================================================",
    "",
    "# Create the global CONFIG object",
    "CONFIG = create_config()",
    "",
    "# Optimize GPU",
    "if CONFIG.has_gpu:",
    "    optimize_gpu(CONFIG)",
    "",
    "# Add src to path",
    "src_path = str(CONFIG.project_root / 'src')",
    "if src_path not in sys.path:",
    "    sys.path.insert(0, str(CONFIG.project_root))",
    "    sys.path.insert(0, src_path)",
    "",
    "# Print summary",
    "print(CONFIG.summary())",
    "print(\"\\nCONFIG object created. All cells will use CONFIG.xxx for paths and settings.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "#@title 2.2 Install Dependencies (Colab only) { display-mode: \"form\" }\n",
    "\n",
    "def require_config():\n",
    "    \"\"\"Ensure CONFIG exists. Call at start of every cell.\"\"\"\n",
    "    if 'CONFIG' not in globals():\n",
    "        raise RuntimeError(\n",
    "            \"CONFIG not found. Please run Cell 2.1 (Environment Setup) first.\"\n",
    "        )\n",
    "    return globals()['CONFIG']\n",
    "\n",
    "config = require_config()\n",
    "\n",
    "if not config.is_colab:\n",
    "    print(\"[Skipped] Local environment - dependencies should be pre-installed.\")\n",
    "    print(\"Run: pip install -r requirements.txt\")\n",
    "    config.packages_installed = True\n",
    "else:\n",
    "    print(\"[Colab] Installing dependencies...\")\n",
    "    \n",
    "    packages = [\n",
    "        \"torch>=2.0.0\", \"torchvision\",\n",
    "        \"xgboost>=2.0.0\", \"lightgbm>=4.0.0\", \"catboost>=1.2.0\",\n",
    "        \"optuna>=3.4.0\",\n",
    "        \"ta>=0.11.0\", \"pywavelets>=1.5.0\",\n",
    "        \"pyarrow>=14.0.0\", \"numba>=0.58.0\",\n",
    "        \"psutil>=5.9.0\", \"joblib>=1.3.0\", \"pyyaml>=6.0.0\",\n",
    "        \"onnx>=1.15.0\", \"onnxruntime>=1.16.0\", \"skl2onnx>=1.16.0\",\n",
    "    ]\n",
    "    \n",
    "    pkg_str = \" \".join(f'\"{p}\"' for p in packages)\n",
    "    result = subprocess.run(\n",
    "        f\"{sys.executable} -m pip install -q {pkg_str}\",\n",
    "        shell=True, capture_output=True, text=True\n",
    "    )\n",
    "    \n",
    "    if result.returncode == 0:\n",
    "        print(\"[OK] All packages installed.\")\n",
    "        config.packages_installed = True\n",
    "    else:\n",
    "        print(f\"[ERROR] Package installation failed:\\n{result.stderr}\")\n",
    "        config.packages_installed = False"
   ]
  },
