   "outputs": [],
   "source": "#@title 3.2 Run Data Pipeline { display-mode: \"form\" }\n\nconfig = require_config()\n\nif not RUN_DATA_PIPELINE:\n    print(\"[Skipped] Data pipeline disabled. Set RUN_DATA_PIPELINE = True to enable.\")\nelif config.raw_data_file is None:\n    print(\"[ERROR] No raw data file found. Run Cell 3.1 first.\")\nelse:\n    import time\n    from pathlib import Path\n    \n    print(\"=\" * 70)\n    print(\" PHASE 1: DATA PIPELINE\")\n    print(\"=\" * 70)\n    print(f\"\\n  Symbol: {config.symbol}\")\n    print(f\"  Source: {config.raw_data_file.name}\")\n    print(f\"  Primary TF: {config.primary_timeframe}\")\n    print(f\"  MTF Strategy: {config.mtf_strategy} -> {config.mtf_timeframes if config.mtf_timeframes else 'None'}\")\n    \n    # Copy data to project directory if needed (Colab)\n    if config.is_colab and config.raw_data_file is not None:\n        project_raw_dir = config.project_root / 'data/raw'\n        project_raw_dir.mkdir(parents=True, exist_ok=True)\n        \n        target_filename = f\"{config.symbol}_1m{config.raw_data_file.suffix}\"\n        target_path = project_raw_dir / target_filename\n        \n        if not str(config.raw_data_file).startswith(str(config.project_root)):\n            if not target_path.exists():\n                print(f\"\\n  Copying data to project directory...\")\n                shutil.copy2(config.raw_data_file, target_path)\n                print(f\"  Done: {target_path.name}\")\n    \n    # Run pipeline\n    start_time = time.time()\n    \n    try:\n        from src.phase1.runner import PipelineRunner\n        from src.phase1.config import PipelineConfig\n        \n        # Create pipeline config with MTF settings\n        pipeline_config = PipelineConfig(\n            symbols=[config.symbol],\n            horizons=config.horizon_list,\n            train_ratio=TRAIN_RATIO,\n            val_ratio=VAL_RATIO,\n            test_ratio=TEST_RATIO,\n            purge_bars=PURGE_BARS,\n            embargo_bars=EMBARGO_BARS,\n            random_seed=RANDOM_SEED,\n            # MTF Settings\n            target_timeframe=config.primary_timeframe,\n            mtf_timeframes=config.mtf_timeframes,\n            mtf_mode=config.mtf_mode,\n        )\n        \n        # Run pipeline\n        runner = PipelineRunner(pipeline_config)\n        result = runner.run()\n        \n        elapsed = time.time() - start_time\n        \n        if result.success:\n            print(f\"\\n[OK] Pipeline completed in {elapsed:.1f}s\")\n            config.data_ready = True\n            \n            # Checkpoint\n            if config.is_colab and CHECKPOINT_INTERVAL > 0:\n                save_checkpoint(\n                    {'pipeline_result': result, 'symbol': config.symbol},\n                    'pipeline_complete'\n                )\n        else:\n            print(f\"\\n[ERROR] Pipeline failed: {result.error}\")\n            config.data_ready = False\n            \n    except ImportError as e:\n        print(f\"\\n[ERROR] Import failed: {e}\")\n        print(\"Make sure src/ is in the Python path.\")\n        config.data_ready = False\n    except Exception as e:\n        print(f\"\\n[ERROR] Pipeline failed: {e}\")\n        config.data_ready = False\n    \n    clear_memory(verbose=False)"
  },
