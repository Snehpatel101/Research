    "#@title 4.3 Test Set Evaluation { display-mode: \"form\" }\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from sklearn.metrics import accuracy_score, f1_score, classification_report\n",
    "\n",
    "#@markdown ### Evaluation Options\n",
    "run_test_evaluation = True  #@param {type: \"boolean\"}\n",
    "show_generalization_gap = True  #@param {type: \"boolean\"}\n",
    "\n",
    "config = require_config()\n",
    "\n",
    "if not run_test_evaluation:\n",
    "    print(\"[Skipped] Test evaluation disabled.\")\n",
    "elif not config.training_results:\n",
    "    print(\"[ERROR] No trained models. Run Cell 4.1 first.\")\n",
    "else:\n",
    "    print(\"=\" * 70)\n",
    "    print(\" TEST SET EVALUATION\")\n",
    "    print(\"=\" * 70)\n",
    "    \n",
    "    try:\n",
    "        from src.phase1.stages.datasets.container import TimeSeriesDataContainer\n",
    "        \n",
    "        # Load data\n",
    "        container = TimeSeriesDataContainer.from_parquet_dir(\n",
    "            path=config.splits_dir,\n",
    "            horizon=config.training_horizon\n",
    "        )\n",
    "        \n",
    "        X_test = container.splits['test'].features\n",
    "        y_test = container.splits['test'].labels\n",
    "        \n",
    "        print(f\"\\nTest set: {len(y_test):,} samples\")\n",
    "        \n",
    "        for model_name, data in config.training_results.items():\n",
    "            if 'error' in data:\n",
    "                continue\n",
    "            \n",
    "            print(f\"\\n--- {model_name} ---\")\n",
    "            \n",
    "            try:\n",
    "                # Load model\n",
    "                from src.models import ModelRegistry\n",
    "                model_path = data.get('model_path')\n",
    "                if model_path:\n",
    "                    model_class = ModelRegistry.get(model_name)\n",
    "                    model = model_class.load(model_path)\n",
    "                    \n",
    "                    # Predict\n",
    "                    predictions = model.predict(X_test)\n",
    "                    y_pred = predictions.classes\n",
    "                    \n",
    "                    # Metrics\n",
    "                    test_acc = accuracy_score(y_test, y_pred)\n",
    "                    test_f1 = f1_score(y_test, y_pred, average='macro')\n",
    "                    \n",
    "                    config.test_results[model_name] = {\n",
    "                        'accuracy': test_acc,\n",
    "                        'macro_f1': test_f1,\n",
    "                        'predictions': y_pred,\n",
    "                    }\n",
    "                    \n",
    "                    print(f\"  Test Accuracy: {test_acc:.4f}\")\n",
    "                    print(f\"  Test Macro F1: {test_f1:.4f}\")\n",
    "                    \n",
    "                    # Generalization gap\n",
    "                    if show_generalization_gap:\n",
    "                        val_f1 = data.get('metrics', {}).get('macro_f1', 0)\n",
    "                        gap = (test_f1 - val_f1) / val_f1 * 100 if val_f1 > 0 else 0\n",
    "                        print(f\"  Gap (Test - Val): {gap:+.2f}%\")\n",
    "                        \n",
    "            except Exception as e:\n",
    "                print(f\"  [ERROR] {e}\")\n",
    "        \n",
    "        del container, X_test, y_test\n",
    "        clear_memory(verbose=False)\n",
    "        \n",
    "    except Exception as e:\n",
    "        print(f\"\\n[ERROR] Test evaluation failed: {e}\")"
   ]
  },
  {
   "cell_type": "code",
   "source": "#@title 4.4 Trading Performance Metrics { display-mode: \"form\" }\n\nimport numpy as np\nimport pandas as pd\n\n#@markdown ### Trading Metrics Configuration\n#@markdown These metrics help bridge ML accuracy to actual trading performance.\nrun_trading_metrics = True  #@param {type: \"boolean\"}\nassumed_win_size = 1.0  #@param {type: \"number\"}\n#@markdown Average points gained on correct directional prediction\nassumed_loss_size = 1.0  #@param {type: \"number\"}\n#@markdown Average points lost on incorrect directional prediction\ntransaction_cost = 0.0  #@param {type: \"number\"}\n#@markdown Round-trip transaction cost in points (e.g., 0.5 for futures)\n\nconfig = require_config()\n\nif not run_trading_metrics:\n    print(\"[Skipped] Trading metrics disabled.\")\nelif not config.test_results:\n    print(\"[ERROR] No test results. Run Cell 4.3 first.\")\nelse:\n    print(\"=\" * 70)\n    print(\" TRADING PERFORMANCE METRICS\")\n    print(\"=\" * 70)\n    print(f\"\\n  Assumed Win Size: {assumed_win_size} points\")\n    print(f\"  Assumed Loss Size: {assumed_loss_size} points\")\n    print(f\"  Transaction Cost: {transaction_cost} points\")\n    \n    try:\n        from src.phase1.stages.datasets.container import TimeSeriesDataContainer\n        \n        # Load data for ground truth\n        container = TimeSeriesDataContainer.from_parquet_dir(\n            path=config.splits_dir,\n            horizon=config.training_horizon\n        )\n        y_test = container.splits['test'].labels\n        \n        # Class mapping: 0=Short, 1=Hold, 2=Long\n        CLASS_NAMES = {0: \"Short\", 1: \"Hold\", 2: \"Long\"}\n        \n        def calculate_trading_metrics(y_true: np.ndarray, y_pred: np.ndarray) -> dict:\n            \"\"\"Calculate trading-specific performance metrics.\n            \n            Args:\n                y_true: Ground truth labels (0=Short, 1=Hold, 2=Long)\n                y_pred: Predicted labels\n                \n            Returns:\n                Dict with trading metrics\n            \"\"\"\n            # Convert to numpy arrays\n            y_true = np.array(y_true)\n            y_pred = np.array(y_pred)\n            \n            # Only consider directional trades (not Hold predictions)\n            trade_mask = y_pred != 1  # Exclude Hold predictions\n            n_trades = trade_mask.sum()\n            \n            if n_trades == 0:\n                return {\n                    \"n_trades\": 0,\n                    \"win_rate\": 0.0,\n                    \"expected_value\": 0.0,\n                    \"profit_factor\": 0.0,\n                    \"max_drawdown\": 0.0,\n                }\n            \n            # Directional correctness (did we predict the right direction?)\n            # Map: 0 (Short) -> -1, 1 (Hold) -> 0, 2 (Long) -> 1\n            pred_direction = np.where(y_pred == 0, -1, np.where(y_pred == 2, 1, 0))\n            true_direction = np.where(y_true == 0, -1, np.where(y_true == 2, 1, 0))\n            \n            # A trade is \"correct\" if:\n            # - We went Long (pred=2) and market went Long (true=2)\n            # - We went Short (pred=0) and market went Short (true=0)\n            # - We went Long (pred=2) and market stayed Neutral (true=1) -> partial win\n            # For simplicity: correct = pred_direction * true_direction > 0\n            # or pred == true for directional trades\n            \n            trade_preds = y_pred[trade_mask]\n            trade_truths = y_true[trade_mask]\n            \n            # Correct = predicted direction matches actual direction\n            # Win if we predicted Long (2) and actual was Long (2), or Short (0) and actual Short (0)\n            wins = (trade_preds == trade_truths)\n            # Also count partial wins: predicted direction, actual was neutral\n            partial_wins = (trade_truths == 1)  # We traded, market was neutral\n            \n            n_wins = wins.sum()\n            n_losses = n_trades - n_wins\n            \n            # Win Rate\n            win_rate = n_wins / n_trades if n_trades > 0 else 0.0\n            loss_rate = 1.0 - win_rate\n            \n            # Expected Value (EV)\n            # EV = (Win_Rate * Avg_Win) - (Loss_Rate * Avg_Loss) - Transaction_Cost\n            avg_win = assumed_win_size\n            avg_loss = assumed_loss_size\n            ev = (win_rate * avg_win) - (loss_rate * avg_loss) - transaction_cost\n            \n            # Profit Factor = Gross Wins / Gross Losses\n            gross_wins = n_wins * avg_win\n            gross_losses = n_losses * avg_loss\n            profit_factor = gross_wins / gross_losses if gross_losses > 0 else float('inf')\n            \n            # Simulate PnL for Max Drawdown calculation\n            pnl = []\n            for pred, truth in zip(trade_preds, trade_truths):\n                if pred == truth:  # Correct prediction\n                    pnl.append(avg_win - transaction_cost)\n                else:  # Incorrect prediction\n                    pnl.append(-avg_loss - transaction_cost)\n            \n            pnl = np.array(pnl)\n            cumulative_pnl = np.cumsum(pnl)\n            \n            # Max Drawdown\n            running_max = np.maximum.accumulate(cumulative_pnl)\n            drawdowns = running_max - cumulative_pnl\n            max_drawdown = drawdowns.max() if len(drawdowns) > 0 else 0.0\n            \n            # Sharpe Ratio (simplified, assuming daily returns)\n            if len(pnl) > 1 and np.std(pnl) > 0:\n                sharpe = np.mean(pnl) / np.std(pnl) * np.sqrt(252)  # Annualized\n            else:\n                sharpe = 0.0\n            \n            # Per-class accuracy\n            class_accuracy = {}\n            for cls in [0, 1, 2]:\n                mask = y_true == cls\n                if mask.sum() > 0:\n                    class_accuracy[CLASS_NAMES[cls]] = (y_pred[mask] == cls).mean()\n                else:\n                    class_accuracy[CLASS_NAMES[cls]] = 0.0\n            \n            return {\n                \"n_trades\": int(n_trades),\n                \"n_wins\": int(n_wins),\n                \"n_losses\": int(n_losses),\n                \"win_rate\": float(win_rate),\n                \"expected_value\": float(ev),\n                \"profit_factor\": float(profit_factor),\n                \"max_drawdown\": float(max_drawdown),\n                \"sharpe_ratio\": float(sharpe),\n                \"total_pnl\": float(cumulative_pnl[-1]) if len(cumulative_pnl) > 0 else 0.0,\n                \"class_accuracy\": class_accuracy,\n            }\n        \n        # Calculate metrics for each model\n        print(\"\\n\" + \"-\" * 70)\n        all_trading_metrics = {}\n        \n        for model_name, data in config.test_results.items():\n            if 'predictions' not in data:\n                continue\n            \n            y_pred = data['predictions']\n            metrics = calculate_trading_metrics(y_test, y_pred)\n            all_trading_metrics[model_name] = metrics\n            \n            print(f\"\\n--- {model_name} ---\")\n            print(f\"  Trades: {metrics['n_trades']} ({metrics['n_wins']} wins, {metrics['n_losses']} losses)\")\n            print(f\"  Win Rate: {metrics['win_rate']:.2%}\")\n            print(f\"  Expected Value (EV): {metrics['expected_value']:+.4f} points/trade\")\n            print(f\"  Profit Factor: {metrics['profit_factor']:.2f}\")\n            print(f\"  Sharpe Ratio: {metrics['sharpe_ratio']:.2f}\")\n            print(f\"  Max Drawdown: {metrics['max_drawdown']:.2f} points\")\n            print(f\"  Total PnL: {metrics['total_pnl']:+.2f} points\")\n            print(f\"  Per-Class Accuracy:\")\n            for cls_name, acc in metrics['class_accuracy'].items():\n                print(f\"    {cls_name}: {acc:.2%}\")\n        \n        # Store in test_results\n        for model_name, metrics in all_trading_metrics.items():\n            if model_name in config.test_results:\n                config.test_results[model_name]['trading_metrics'] = metrics\n        \n        # Summary Table\n        if all_trading_metrics:\n            print(\"\\n\" + \"=\" * 70)\n            print(\" TRADING METRICS SUMMARY\")\n            print(\"=\" * 70)\n            \n            rows = []\n            for model_name, metrics in all_trading_metrics.items():\n                rows.append({\n                    'Model': model_name,\n                    'Trades': metrics['n_trades'],\n                    'Win Rate': f\"{metrics['win_rate']:.1%}\",\n                    'EV': f\"{metrics['expected_value']:+.3f}\",\n                    'PF': f\"{metrics['profit_factor']:.2f}\",\n                    'Sharpe': f\"{metrics['sharpe_ratio']:.2f}\",\n                    'MaxDD': f\"{metrics['max_drawdown']:.1f}\",\n                    'Total PnL': f\"{metrics['total_pnl']:+.1f}\",\n                })\n            \n            summary_df = pd.DataFrame(rows)\n            summary_df = summary_df.sort_values('EV', ascending=False, key=lambda x: x.str.replace('+', '').astype(float))\n            print(\"\\n\")\n            print(summary_df.to_string(index=False))\n            \n            # Interpretation guide\n            print(\"\\n--- Metric Interpretation ---\")\n            print(\"  EV > 0: Strategy has positive expectancy (profitable long-term)\")\n            print(\"  PF > 1: Gross wins exceed gross losses\")\n            print(\"  Sharpe > 1: Good risk-adjusted returns\")\n            print(\"  Sharpe > 2: Excellent risk-adjusted returns\")\n        \n        del container, y_test\n        clear_memory(verbose=False)\n        \n    except Exception as e:\n        print(f\"\\n[ERROR] Trading metrics calculation failed: {e}\")\n        import traceback\n        traceback.print_exc()\n\nprint(\"\\n\" + \"=\" * 70)",
   "metadata": {},
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "#@title 4.5 Realistic Trading Simulation { display-mode: \"form\" }\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from typing import Dict, Tuple, List\n",
    "\n",
    "#@markdown ### Simulation Options\n",
    "run_trading_sim = True  #@param {type: \"boolean\"}\n",
    "#@markdown Run realistic backtests with transaction costs, slippage, and Kelly sizing\n",
    "\n",
    "show_equity_curve = True  #@param {type: \"boolean\"}\n",
    "show_drawdown_chart = True  #@param {type: \"boolean\"}\n",
    "show_trade_distribution = True  #@param {type: \"boolean\"}\n",
    "show_kelly_evolution = True  #@param {type: \"boolean\"}\n",
    "\n",
    "config = require_config()\n",
    "\n",
    "if not run_trading_sim:\n",
    "    print(\"[Skipped] Trading simulation disabled.\")\n",
    "elif not config.test_results:\n",
    "    print(\"[ERROR] No test results. Run Cell 4.3 first.\")\n",
    "else:\n",
    "    print(\"=\" * 70)\n",
    "    print(\" REALISTIC TRADING SIMULATION\")\n",
    "    print(\"=\" * 70)\n",
    "    print(f\"\\n  Position Sizing: {POSITION_SIZING_METHOD}\")\n",
    "    print(f\"  Initial Capital: ${INITIAL_CAPITAL:,}\")\n",
    "    print(f\"  Commission: ${COMMISSION_PER_SHARE}/share + ${FIXED_FEE_PER_TRADE}/trade\")\n",
    "    print(f\"  Slippage: {SLIPPAGE_BPS} bps\")\n",
    "    print(f\"  Max Position: {MAX_POSITION_PCT*100}% of capital\")\n",
    "    \n",
    "    def calculate_slippage_with_impact(price, shares, typical_volume=10000, base_slippage_bps=SLIPPAGE_BPS):\n",
    "        \"\"\"Calculate market impact-adjusted slippage.\"\"\"\n",
    "        impact_multiplier = (shares / typical_volume) ** 0.5\n",
    "        effective_slippage_bps = base_slippage_bps * max(1.0, impact_multiplier)\n",
    "        return price * effective_slippage_bps / 10000\n",
    "    \n",
    "    def calculate_transaction_costs(shares, entry_price, exit_price):\n",
    "        \"\"\"Calculate total round-trip transaction costs.\"\"\"\n",
    "        # Commission\n",
    "        commission = 2 * (shares * COMMISSION_PER_SHARE + FIXED_FEE_PER_TRADE)  # Round-trip\n",
    "        \n",
    "        # Slippage (entry + exit)\n",
    "        entry_slippage = calculate_slippage_with_impact(entry_price, shares)\n",
    "        exit_slippage = calculate_slippage_with_impact(exit_price, shares)\n",
    "        slippage_cost = shares * (entry_slippage + exit_slippage)\n",
    "        \n",
    "        return commission + slippage_cost\n",
    "    \n",
    "    def simulate_trades(predictions, actuals, prices, initial_capital=INITIAL_CAPITAL):\n",
    "        \"\"\"Simulate realistic trading with costs and position sizing.\"\"\"\n",
    "        capital = initial_capital\n",
    "        equity_curve = [capital]\n",
    "        positions = []\n",
    "        trades = []\n",
    "        \n",
    "        # Calculate Kelly fractions\n",
    "        if POSITION_SIZING_METHOD in [\"kelly\", \"kelly_half\"]:\n",
    "            kelly_fractions = calculate_kelly_fraction(predictions, actuals, prices, MAX_POSITION_PCT)\n",
    "            if POSITION_SIZING_METHOD == \"kelly_half\":\n",
    "                kelly_fractions *= 0.5  # Half-Kelly\n",
    "        else:\n",
    "            kelly_fractions = None\n",
    "        \n",
    "        current_position = None\n",
    "        peak_equity = capital\n",
    "        \n",
    "        for i in range(len(predictions)):\n",
    "            pred = predictions[i]\n",
    "            price = prices[i]\n",
    "            \n",
    "            # Check for stop loss / take profit\n",
    "            if current_position is not None:\n",
    "                entry_price = current_position['entry_price']\n",
    "                pnl_pct = (price - entry_price) / entry_price\n",
    "                \n",
    "                exit_triggered = False\n",
    "                exit_reason = None\n",
    "                \n",
    "                if USE_STOP_LOSS and pnl_pct < -STOP_LOSS_PCT:\n",
    "                    exit_triggered = True\n",
    "                    exit_reason = 'stop_loss'\n",
    "                elif USE_TAKE_PROFIT and pnl_pct > TAKE_PROFIT_PCT:\n",
    "                    exit_triggered = True\n",
    "                    exit_reason = 'take_profit'\n",
    "                \n",
    "                if exit_triggered:\n",
    "                    # Close position\n",
    "                    shares = current_position['shares']\n",
    "                    gross_pnl = shares * (price - entry_price)\n",
    "                    costs = calculate_transaction_costs(shares, entry_price, price)\n",
    "                    net_pnl = gross_pnl - costs\n",
    "                    \n",
    "                    capital += net_pnl\n",
    "                    equity_curve.append(capital)\n",
    "                    \n",
    "                    trades.append({\n",
    "                        'entry_idx': current_position['entry_idx'],\n",
    "                        'exit_idx': i,\n",
    "                        'shares': shares,\n",
    "                        'entry_price': entry_price,\n",
    "                        'exit_price': price,\n",
    "                        'gross_pnl': gross_pnl,\n",
    "                        'costs': costs,\n",
    "                        'net_pnl': net_pnl,\n",
    "                        'exit_reason': exit_reason,\n",
    "                    })\n",
    "                    \n",
    "                    current_position = None\n",
    "                    peak_equity = max(peak_equity, capital)\n",
    "                    continue\n",
    "            \n",
    "            # Trading logic\n",
    "            if pred == 1:  # Hold\n",
    "                equity_curve.append(capital)\n",
    "                continue\n",
    "            \n",
    "            # Close existing position if direction changes\n",
    "            if current_position is not None:\n",
    "                shares = current_position['shares']\n",
    "                entry_price = current_position['entry_price']\n",
    "                gross_pnl = shares * (price - entry_price)\n",
    "                costs = calculate_transaction_costs(shares, entry_price, price)\n",
    "                net_pnl = gross_pnl - costs\n",
    "                \n",
    "                capital += net_pnl\n",
    "                \n",
    "                trades.append({\n",
    "                    'entry_idx': current_position['entry_idx'],\n",
    "                    'exit_idx': i,\n",
    "                    'shares': shares,\n",
    "                    'entry_price': entry_price,\n",
    "                    'exit_price': price,\n",
    "                    'gross_pnl': gross_pnl,\n",
    "                    'costs': costs,\n",
    "                    'net_pnl': net_pnl,\n",
    "                    'exit_reason': 'signal_change',\n",
    "                })\n",
    "                \n",
    "                current_position = None\n",
    "            \n",
    "            # Open new position\n",
    "            if POSITION_SIZING_METHOD == \"fixed\":\n",
    "                shares = FIXED_POSITION_SIZE\n",
    "            elif POSITION_SIZING_METHOD in [\"kelly\", \"kelly_half\"]:\n",
    "                position_value = capital * kelly_fractions[i]\n",
    "                shares = int(position_value / price)\n",
    "            elif POSITION_SIZING_METHOD == \"volatility_scaled\":\n",
    "                # Use inverse volatility scaling\n",
    "                lookback = min(i, 20)\n",
    "                if lookback > 1:\n",
    "                    recent_returns = np.diff(prices[max(0, i-lookback):i+1]) / prices[max(0, i-lookback):i]\n",
    "                    volatility = np.std(recent_returns)\n",
    "                    target_risk = 0.02  # 2% risk per trade\n",
    "                    position_value = capital * target_risk / (volatility if volatility > 0 else 0.01)\n",
    "                    shares = int(position_value / price)\n",
    "                else:\n",
    "                    shares = FIXED_POSITION_SIZE\n",
    "            else:\n",
    "                shares = FIXED_POSITION_SIZE\n",
    "            \n",
    "            # Cap position size\n",
    "            max_shares = int((capital * MAX_POSITION_PCT) / price)\n",
    "            shares = min(shares, max_shares)\n",
    "            shares = max(1, shares)  # At least 1 share\n",
    "            \n",
    "            # Apply slippage to entry\n",
    "            entry_slippage = calculate_slippage_with_impact(price, shares)\n",
    "            effective_entry_price = price * (1 + entry_slippage / price)\n",
    "            \n",
    "            current_position = {\n",
    "                'entry_idx': i,\n",
    "                'shares': shares,\n",
    "                'entry_price': effective_entry_price,\n",
    "                'signal': pred,\n",
    "            }\n",
    "            \n",
    "            equity_curve.append(capital)\n",
    "            peak_equity = max(peak_equity, capital)\n",
    "        \n",
    "        # Close any open position at end\n",
    "        if current_position is not None:\n",
    "            shares = current_position['shares']\n",
    "            entry_price = current_position['entry_price']\n",
    "            price = prices[-1]\n",
    "            gross_pnl = shares * (price - entry_price)\n",
    "            costs = calculate_transaction_costs(shares, entry_price, price)\n",
    "            net_pnl = gross_pnl - costs\n",
    "            \n",
    "            capital += net_pnl\n",
    "            equity_curve.append(capital)\n",
    "            \n",
    "            trades.append({\n",
    "                'entry_idx': current_position['entry_idx'],\n",
    "                'exit_idx': len(prices) - 1,\n",
    "                'shares': shares,\n",
    "                'entry_price': entry_price,\n",
    "                'exit_price': price,\n",
    "                'gross_pnl': gross_pnl,\n",
    "                'costs': costs,\n",
    "                'net_pnl': net_pnl,\n",
    "                'exit_reason': 'end_of_data',\n",
    "            })\n",
    "        \n",
    "        return {\n",
    "            'final_capital': capital,\n",
    "            'equity_curve': np.array(equity_curve),\n",
    "            'trades': trades,\n",
    "            'kelly_fractions': kelly_fractions,\n",
    "        }\n",
    "    \n",
    "    # Run simulation for each model\n",
    "    print(\"\\n\" + \"=\" * 70)\n",
    "    print(\" MODEL RESULTS\")\n",
    "    print(\"=\" * 70)\n",
    "    \n",
    "    for model_name, result in config.test_results.items():\n",
    "        print(f\"\\n--- {model_name} ---\")\n",
    "        \n",
    "        y_pred = result['y_pred']\n",
    "        y_true = result['y_true']\n",
    "        \n",
    "        # Get prices (assuming they're stored or using indices)\n",
    "        # For demo, generate synthetic prices based on predictions\n",
    "        # In real implementation, load actual test set prices\n",
    "        base_price = 100.0\n",
    "        returns = np.random.randn(len(y_pred)) * 0.01  # 1% daily vol\n",
    "        prices = base_price * np.exp(np.cumsum(returns))\n",
    "        \n",
    "        sim_result = simulate_trades(y_pred, y_true, prices)\n",
    "        \n",
    "        # Calculate metrics\n",
    "        trades_df = pd.DataFrame(sim_result['trades'])\n",
    "        \n",
    "        if len(trades_df) == 0:\n",
    "            print(\"  No trades executed.\")\n",
    "            continue\n",
    "        \n",
    "        total_return = (sim_result['final_capital'] - INITIAL_CAPITAL) / INITIAL_CAPITAL\n",
    "        gross_pnl = trades_df['gross_pnl'].sum()\n",
    "        total_costs = trades_df['costs'].sum()\n",
    "        net_pnl = trades_df['net_pnl'].sum()\n",
    "        \n",
    "        winning_trades = trades_df[trades_df['net_pnl'] > 0]\n",
    "        losing_trades = trades_df[trades_df['net_pnl'] <= 0]\n",
    "        \n",
    "        win_rate = len(winning_trades) / len(trades_df) if len(trades_df) > 0 else 0\n",
    "        avg_win = winning_trades['net_pnl'].mean() if len(winning_trades) > 0 else 0\n",
    "        avg_loss = abs(losing_trades['net_pnl'].mean()) if len(losing_trades) > 0 else 0\n",
    "        profit_factor = abs(winning_trades['net_pnl'].sum() / losing_trades['net_pnl'].sum()) if len(losing_trades) > 0 and losing_trades['net_pnl'].sum() != 0 else 0\n",
    "        \n",
    "        # Calculate Sharpe ratio\n",
    "        equity_returns = np.diff(sim_result['equity_curve']) / sim_result['equity_curve'][:-1]\n",
    "        sharpe = np.mean(equity_returns) / np.std(equity_returns) * np.sqrt(252) if np.std(equity_returns) > 0 else 0\n",
    "        \n",
    "        # Calculate max drawdown\n",
    "        equity = sim_result['equity_curve']\n",
    "        running_max = np.maximum.accumulate(equity)\n",
    "        drawdown = (equity - running_max) / running_max\n",
    "        max_drawdown = abs(drawdown.min())\n",
    "        \n",
    "        print(f\"\\n  Total Return: {total_return*100:.2f}%\")\n",
    "        print(f\"  Net Sharpe Ratio: {sharpe:.3f}\")\n",
    "        print(f\"  Max Drawdown: {max_drawdown*100:.2f}%\")\n",
    "        print(f\"  \\n  Trades: {len(trades_df)}\")\n",
    "        print(f\"  Win Rate: {win_rate*100:.2f}%\")\n",
    "        print(f\"  Profit Factor: {profit_factor:.2f}\")\n",
    "        print(f\"  Avg Win: ${avg_win:.2f}\")\n",
    "        print(f\"  Avg Loss: ${avg_loss:.2f}\")\n",
    "        print(f\"  \\n  Gross P&L: ${gross_pnl:.2f}\")\n",
    "        print(f\"  Total Costs: ${total_costs:.2f}\")\n",
    "        print(f\"  Net P&L: ${net_pnl:.2f}\")\n",
    "        print(f\"  Costs as % of Gross: {(total_costs/abs(gross_pnl)*100) if gross_pnl != 0 else 0:.2f}%\")\n",
    "        \n",
    "        # Store results\n",
    "        if not hasattr(config, 'trading_sim_results'):\n",
    "            config.trading_sim_results = {}\n",
    "        \n",
    "        config.trading_sim_results[model_name] = {\n",
    "            'final_capital': sim_result['final_capital'],\n",
    "            'total_return': total_return,\n",
    "            'sharpe': sharpe,\n",
    "            'max_drawdown': max_drawdown,\n",
    "            'num_trades': len(trades_df),\n",
    "            'win_rate': win_rate,\n",
    "            'profit_factor': profit_factor,\n",
    "            'avg_win': avg_win,\n",
    "            'avg_loss': avg_loss,\n",
    "            'gross_pnl': gross_pnl,\n",
    "            'total_costs': total_costs,\n",
    "            'net_pnl': net_pnl,\n",
    "            'equity_curve': sim_result['equity_curve'],\n",
    "            'trades': trades_df,\n",
    "            'kelly_fractions': sim_result['kelly_fractions'],\n",
    "        }\n",
    "        \n",
    "        # Visualizations\n",
    "        if show_equity_curve or show_drawdown_chart or show_trade_distribution or show_kelly_evolution:\n",
    "            n_plots = sum([show_equity_curve, show_drawdown_chart, show_trade_distribution, show_kelly_evolution])\n",
    "            fig, axes = plt.subplots(n_plots, 1, figsize=(12, 4*n_plots))\n",
    "            if n_plots == 1:\n",
    "                axes = [axes]\n",
    "            \n",
    "            plot_idx = 0\n",
    "            \n",
    "            if show_equity_curve:\n",
    "                axes[plot_idx].plot(sim_result['equity_curve'], linewidth=2)\n",
    "                axes[plot_idx].axhline(y=INITIAL_CAPITAL, color='gray', linestyle='--', alpha=0.5)\n",
    "                axes[plot_idx].set_title(f\"{model_name} - Equity Curve\", fontsize=12, fontweight='bold')\n",
    "                axes[plot_idx].set_xlabel(\"Trade Number\")\n",
    "                axes[plot_idx].set_ylabel(\"Capital ($)\")\n",
    "                axes[plot_idx].grid(True, alpha=0.3)\n",
    "                plot_idx += 1\n",
    "            \n",
    "            if show_drawdown_chart:\n",
    "                axes[plot_idx].fill_between(range(len(drawdown)), drawdown * 100, 0, alpha=0.3, color='red')\n",
    "                axes[plot_idx].plot(drawdown * 100, color='red', linewidth=2)\n",
    "                axes[plot_idx].set_title(f\"{model_name} - Drawdown\", fontsize=12, fontweight='bold')\n",
    "                axes[plot_idx].set_xlabel(\"Trade Number\")\n",
    "                axes[plot_idx].set_ylabel(\"Drawdown (%)\")\n",
    "                axes[plot_idx].grid(True, alpha=0.3)\n",
    "                plot_idx += 1\n",
    "            \n",
    "            if show_trade_distribution:\n",
    "                axes[plot_idx].hist(trades_df['net_pnl'], bins=30, edgecolor='black', alpha=0.7)\n",
    "                axes[plot_idx].axvline(x=0, color='red', linestyle='--', linewidth=2)\n",
    "                axes[plot_idx].set_title(f\"{model_name} - Trade P&L Distribution\", fontsize=12, fontweight='bold')\n",
    "                axes[plot_idx].set_xlabel(\"Net P&L ($)\")\n",
    "                axes[plot_idx].set_ylabel(\"Frequency\")\n",
    "                axes[plot_idx].grid(True, alpha=0.3)\n",
    "                plot_idx += 1\n",
    "            \n",
    "            if show_kelly_evolution and sim_result['kelly_fractions'] is not None:\n",
    "                axes[plot_idx].plot(sim_result['kelly_fractions'] * 100, linewidth=2)\n",
    "                axes[plot_idx].axhline(y=MAX_POSITION_PCT * 100, color='red', linestyle='--', alpha=0.5, label='Max Position')\n",
    "                axes[plot_idx].set_title(f\"{model_name} - Kelly Fraction Evolution\", fontsize=12, fontweight='bold')\n",
    "                axes[plot_idx].set_xlabel(\"Bar Index\")\n",
    "                axes[plot_idx].set_ylabel(\"Kelly Fraction (%)\")\n",
    "                axes[plot_idx].legend()\n",
    "                axes[plot_idx].grid(True, alpha=0.3)\n",
    "                plot_idx += 1\n",
    "            \n",
    "            plt.tight_layout()\n",
    "            plt.show()\n",
    "    \n",
    "    print(\"\\n\" + \"=\" * 70)\n",
    "    print(\" SIMULATION COMPLETE\")\n",
    "    print(\"=\" * 70)\n",
    "    print(f\"Results stored in CONFIG.trading_sim_results\")\n"
   ]
  },
