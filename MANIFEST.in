# sdist contents beyond what setuptools adds itself (pyproject.toml, the src
# package incl. package data, LICENSE via license-files). Tests, scripts, docs
# and project notes stay in the repository, not in the distribution.
include README.md
include LICENSE
include CHANGELOG.md

# Exclude build artifacts and caches
global-exclude __pycache__
global-exclude *.py[co]
global-exclude .DS_Store
global-exclude *.so
